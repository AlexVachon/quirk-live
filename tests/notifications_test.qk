// The demo's Notification component, on the counter page: an enum prop,
// methods in the template, @after timers, emit to the parent, keyed children.
use web
use live
use test
from examples.app.src.pages.counter use { CounterPage }

define make_app() -> web.App {
    router := live.Router()
    router.add("/", CounterPage)
    app := web.App()
    app.mount("/", router)
    return app
}

define count(html: String, piece: String) -> Int {
    return html.split(piece).length() - 1
}

define test_milestones_show_notifications() -> void {
    s := live.TestSession(make_app())
    s.open("/")
    test.assert_eq(count(s.html, "class=\"notification "), 0)
    s.click("+10")
    test.assert_true(s.html.contains("class=\"notification success\" role=\"status\""), s.html)
    test.assert_true(s.html.contains("<p>You reached 10!</p>"))
    test.assert_true(s.html.contains(">✓</span>"))
    test.assert_true(s.html.contains("delay=\"4000\""))
    s.click("reset")
    test.assert_true(s.html.contains("<p>Counter reset.</p>"))
    test.assert_true(s.html.contains("class=\"notification info\""))
    s.click("−1")
    test.assert_true(s.html.contains("class=\"notification warning\" role=\"alert\""))
    test.assert_eq(count(s.html, "class=\"notification "), 3)
    test.assert_eq(count(s.html, "class=\"time-left\""), 2)         // the warning has no timeout
}

define test_close_and_timers() -> void {
    s := live.TestSession(make_app())
    s.open("/")
    s.click("+10")
    s.click("reset")
    s.click("−1")
    test.assert_eq(count(s.html, "class=\"notification "), 3)
    s.run_timers()                                                   // success and info time out
    test.assert_eq(count(s.html, "class=\"notification "), 1)
    test.assert_true(s.html.contains("The count is below zero."))    // timeout 0: stays
    s.click("×")
    test.assert_eq(count(s.html, "class=\"notification "), 0)
    test.assert_true(s.html.contains("<p class=\"count\">-1</p>"))   // the counter is unchanged
}
