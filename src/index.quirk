---
live — interactive web pages written in Quirk and HTML, like Vue but
running on the server.

A component is a struct: state in fields, actions in methods, and its HTML
template in `template()`. Templates show
fields (`{{ count }}`), call methods on events (`@click="add(1)"`), bind
inputs (`model="draft"`) and use other components as tags (`<PlusButton />`).
After each event the page is rendered again and the browser updates in place
— no JavaScript to write.

@example
use web
use live

struct CounterPage : live.Page {
    count: Int

    define on_load(self) -> void {
        self.count = 0
    }

    define add(self, n: Int) -> void {
        self.count = self.count + n
    }

    define template(self) -> String {
        return r"""
            <h1>{{ count }}</h1>
            <button @click="add(1)">+1</button>
        """
    }
}

router := live.Router()
router.add("/", CounterPage)

app := web.App()
app.mount("/", router)
app.listen(3000)
---
use web
use fs
use sys
use crypto
use encoding.json

// ===== reflection (runtime: src/Runtime/libs/live.c) =====
// A struct's fields and public methods by name — what templates use. Fields
// and methods are the struct's own and inherited ones.

--- `obj` has a field `name`. ---
extern define has_field(obj: Any, name: String) -> Bool
--- The value of field `name` (null if there's none). ---
extern define get_field(obj: Any, name: String) -> Any
--- Set field `name` (false if there's none). ---
extern define set_field(obj: Any, name: String, value: Any) -> Bool
--- `obj` has a public method `name`. ---
extern define has_method(obj: Any, name: String) -> Bool
--- Call method `name` with `args` (missing ones take their defaults); ValueError if there's none. ---
extern define call_method(obj: Any, name: String, args: List) -> Any
--- A new struct of type `name`, made without constructor arguments (null if there's none). ---
extern define new_struct(name: String) -> Any
--- The struct's type name ("" for other values). ---
extern define type_name(obj: Any) -> String
--- The source file declaring the struct's type. ---
extern define source_file(obj: Any) -> String
--- The declared type of field `name` ("Int", "List", ...; "" if unknown). ---
extern define field_type(obj: Any, name: String) -> String
--- The struct's field names. ---
extern define field_names(obj: Any) -> List
--- The struct's public method names. ---
extern define method_names(obj: Any) -> List

// ===== components =====

---
A component: a struct with its state in fields and its HTML in a template
— returned from `template()` (a raw string, `r"""..."""`), or in the file
named after the struct (`counter_page.html`) next to the `.qk` file:

    <h1>Count: {{ count }}</h1>
    <button @click="add(1)">+1</button>         calls self.add(1)
    <input model="draft" @enter="save">         self.draft follows the field; Enter calls self.save(text)
    <div @after="close" delay="3000">           calls self.close() 3 s after it appears
    <PlusButton :page="self" />                 another component, by its struct's name
    {% if count >= 10 %}<p>a lot</p>{% end %}
    {% for i, item in items %}<li>{{ item }}</li>{% else %}<li>none</li>{% end %}

`on_load()` sets it up (once). Events call its methods by name; the page
is rendered again after each one. Props: `text="hi {{ name }}"` sets the
child's `text` field (a String), `:count="n + 1"` sets it to the value;
`@done="refresh"` runs when the child calls `self.emit("done")`. A
`<slot />` in a component's template shows what its tag enclosed.

A page is a Component served by a `live.Router` (usually a `live.Page`).
`title()` sets the page title; `self.go(path)` sends the browser to
another page. (The 1.0 way, overriding `render()` and `handle(event,
data)` with `q-click="name"` attributes, still works.)
---
struct Component {
    id: String
    request: web.Request
    _go: String
    _root: Component
    _parent: Component
    _handlers: Map
    _children: Map
    _seen: Map
    _listeners: Map
    _next: Int
    _notes: List          // the root's notifications (live.notify)
    _note_next: Int

    define __init(self) -> void {
        self.id = ""
        self.request = null
        self._go = ""
        self._root = null
        self._parent = null
        self._handlers = {}
        self._children = {}
        self._seen = {}
        self._listeners = {}
        self._next = 0
        self._notes = []
        self._note_next = 1
    }

    --- Set up the component's state (override). Runs once, before it's first shown. ---
    define on_load(self) -> void {
    }

    --- The component's template (override for one written in the .qk file; "" uses its .html file). ---
    define template(self) -> String {
        return ""
    }

    --- Its HTML (the template, rendered). Override to write HTML yourself. ---
    define render(self) -> String {
        return _render_root(self)
    }

    --- React to `event` from the page. Override only for the 1.0 `q-click="name"` style. ---
    define handle(self, event: String, data: Map) -> void {
        _dispatch(self, event, data)
    }

    --- The page title while this component is shown (override; "" leaves it). ---
    define title(self) -> String {
        return ""
    }

    --- After this event, send the browser to `path` (a live page, or any URL). ---
    define go(self, path: String) -> void {
        if self._root != null and self._root != self {
            self._root.go(path)
            return
        }
        self._go = path
    }

    --- Tell the parent: runs its `@event="method"` handler, with `value` (if given). ---
    define emit(self, event: String, value: Any = null) -> void {
        if self._listeners == null or not self._listeners.has(event) { return }
        h: List = self._listeners[event]
        _run_handler(h, value, value != null)
    }

    ---
    Show a notification in a corner of the page, like Element Plus's
    ElNotification — from any page or component, nothing to put in the
    template. Returns its id (for `close_notification`).

    - `type`: "success", "warning", "info", "error" or "" (none)
    - `position`: "top-right" (default), "top-left", "bottom-right", "bottom-left"
    - `duration`: milliseconds before it closes (0: stays until closed);
      the timer pauses while the mouse is on it
    - `show_close`: the × button; `icon`: instead of the type's
    - `on_click()`: when it's clicked; `on_close()`: when it closes (×,
      timeout or close_notification)
    ---
    define notify(self, message: String, title: String = "", type: String = "", position: String = "top-right",
                  duration: Int = 4500, show_close: Bool = true, icon: String = "",
                  on_click: Callable = null, on_close: Callable = null) -> Int {
        root := self._root_of()
        if root._notes == null { root._notes = [] }
        if root._note_next == 0 { root._note_next = 1 }
        n := _Note(root._note_next, message, title, type, position, duration, show_close, icon, on_click, on_close)
        root._note_next = root._note_next + 1
        root._notes.append(n)
        return n.id
    }

    --- Close notification `id` (its `on_close` runs). ---
    define close_notification(self, id: Int) -> void {
        _close_note(self._root_of(), id, true)
    }

    --- Close every notification. ---
    define close_notifications(self) -> void {
        root := self._root_of()
        if root._notes == null { return }
        ids := []
        for it in root._notes {
            n: _Note = it
            ids.append(n.id)
        }
        for i in ids { _close_note(root, Int(i), true) }
    }

    define _root_of(self) -> Component {
        if self._root != null and self._root != self { return self._root }
        return self
    }

    --- A `:param` of the page's path ("/users/:id" → `self.param("id")`); "" if none. ---
    define param(self, name: String) -> String {
        r := self._request()
        if r == null or not r.params.has(name) { return "" }
        return _text(r.params[name])
    }

    --- A `?name=value` of the page's URL; "" if none. ---
    define query(self, name: String) -> String {
        r := self._request()
        if r == null or not r.query.has(name) { return "" }
        return _text(r.query[name])
    }

    define _request(self) -> web.Request {
        if self.request != null { return self.request }
        if self._root != null and self._root != self { return self._root.request }
        return null
    }

    // Runs once, when the component is made for a visitor.
    define _start(self) -> void {
        self.on_load()
    }

    // The first widget of the last build labelled `text` (a Page's; else null).
    define _widget(self, text: String) -> Widget {
        return null
    }

    // The component wrapped in its root element (what the page holds).
    define _root_html(self) -> String {
        return "<div q-root=\"" + self.id + "\">" + _body(self) + "</div>"
    }
}

// ===== notifications (Component.notify) =====

struct _Note {
    id: Int
    message: String
    title: String
    type: String
    position: String
    duration: Int
    show_close: Bool
    icon: String
    on_click: Callable
    on_close: Callable

    define __init(self, id: Int, message: String, title: String, type: String, position: String,
                  duration: Int, show_close: Bool, icon: String, on_click: Callable, on_close: Callable) -> void {
        self.id = id
        self.message = message
        self.title = title
        self.type = type
        self.position = position
        self.duration = duration
        self.show_close = show_close
        self.icon = icon
        self.on_click = on_click
        self.on_close = on_close
    }
}

_note_positions := ["top-right", "top-left", "bottom-right", "bottom-left"]
_note_icons := {"success": "✓", "warning": "!", "info": "i", "error": "✕"}

// What the page shows: the component, then its notifications.
define _body(comp: Component) -> String {
    return comp.render() + _notes_html(comp)
}

define _known_position(p: String) -> Bool {
    for it in _note_positions {
        known: String = it
        if known == p { return true }
    }
    return false
}

define _notes_html(root: Component) -> String {
    if root._notes == null or root._notes.length() == 0 { return "" }
    out := ""
    for p in _note_positions {
        pos: String = p
        items := ""
        for it in root._notes {
            n: _Note = it
            corner := _known_position(n.position) ? n.position : "top-right"
            if corner == pos { items = items + _note_html(root, n) }
        }
        if items != "" { out = out + "<div class=\"q-notifications q-notifications-" + pos + "\" q-key=\"q-notes-" + pos + "\">" + items + "</div>" }
    }
    return out
}

define _note_html(root: Component, n: _Note) -> String {
    ev := "_note:" + String(n.id) + ":"
    side := n.position.endswith("left") ? "left" : "right"
    role := (n.type == "error" or n.type == "warning") ? "alert" : "status"
    kind := n.type == "" ? "" : " q-notification-" + web.escape(n.type)
    out := "<div class=\"q-notification" + kind + (n.on_click != null ? " q-notification-clickable" : "") + "\" role=\"" + role + "\""
    out = out + " q-key=\"q-note-" + String(n.id) + "\" q-transition=\"q-note-" + side + "\" q-pause-hover"
    if n.duration > 0 {
        out = out + " delay=\"" + String(n.duration) + "\" q-after-key=\"" + web.escape(root.id) + "-note-" + String(n.id) + "\" q-after=\"" + ev + "after\""
    }
    if n.on_click != null { out = out + " q-click=\"" + ev + "click\"" }
    out = out + ">"
    icon := n.icon != "" ? n.icon : (_note_icons.has(n.type) ? String(_note_icons[n.type]) : "")
    if icon != "" { out = out + "<span class=\"q-notification-icon\" aria-hidden=\"true\">" + web.escape(icon) + "</span>" }
    out = out + "<div class=\"q-notification-content\">"
    if n.title != "" { out = out + "<strong class=\"q-notification-title\">" + web.escape(n.title) + "</strong>" }
    out = out + "<p class=\"q-notification-message\">" + web.escape(n.message) + "</p></div>"
    if n.show_close { out = out + "<button type=\"button\" class=\"q-notification-close\" aria-label=\"Close\" q-click=\"" + ev + "close\">×</button>" }
    if n.duration > 0 { out = out + "<div class=\"q-notification-time\" style=\"animation-duration: " + String(n.duration) + "ms\"></div>" }
    return out + "</div>"
}

define _close_note(root: Component, id: Int, run_on_close: Bool) -> void {
    if root._notes == null { return }
    kept := []
    gone: _Note = null
    for it in root._notes {
        n: _Note = it
        if n.id == id { gone = n } else { kept.append(n) }
    }
    root._notes = kept
    if gone != null and run_on_close and gone.on_close != null {
        h: Callable = gone.on_close
        h()
    }
}

// "_note:3:close" / ":after" / ":click" from the page.
define _note_event(root: Component, event: String) -> void {
    parts := event.split(":")
    if parts.length() < 3 { return }
    id := Int(String(parts[1]))
    what: String = parts[2]
    if what == "close" or what == "after" {
        _close_note(root, id, true)
        return
    }
    if what == "click" and root._notes != null {
        for it in root._notes {
            n: _Note = it
            if n.id == id and n.on_click != null {
                h: Callable = n.on_click
                h()
                return
            }
        }
    }
}

// The notifications' look (added to every page; override in your CSS).
_notes_css := """<style>
.q-notifications { position: fixed; z-index: 2000; display: flex; flex-direction: column; gap: 12px; width: 330px; max-width: calc(100vw - 32px); pointer-events: none; }
.q-notifications-top-right { top: 16px; right: 16px; }
.q-notifications-top-left { top: 16px; left: 16px; }
.q-notifications-bottom-right { bottom: 16px; right: 16px; flex-direction: column-reverse; }
.q-notifications-bottom-left { bottom: 16px; left: 16px; flex-direction: column-reverse; }
.q-notification { pointer-events: auto; position: relative; overflow: hidden; display: flex; gap: 12px; align-items: flex-start; box-sizing: border-box;
  padding: 14px 26px 14px 13px; border-radius: 8px; background: #fff; color: #303133; border: 1px solid #ebeef5;
  box-shadow: 0 6px 16px rgba(0, 0, 0, .12); font: 14px/1.5 system-ui, sans-serif; --q-tone: #909399; }
.q-notification-clickable { cursor: pointer; }
.q-notification-success { --q-tone: #67c23a; }
.q-notification-warning { --q-tone: #e6a23c; }
.q-notification-info { --q-tone: #909399; }
.q-notification-error { --q-tone: #f56c6c; }
.q-notification-icon { flex: none; width: 24px; height: 24px; border-radius: 50%; display: grid; place-items: center; background: var(--q-tone); color: #fff; font-weight: 700; font-size: 13px; }
.q-notification-content { flex: 1; min-width: 0; }
.q-notification-title { display: block; font-size: 16px; font-weight: 700; margin-bottom: 4px; }
.q-notification-message { margin: 0; color: #606266; overflow-wrap: anywhere; }
.q-notification-close { position: absolute; top: 12px; right: 12px; border: none; background: none; padding: 0; font-size: 16px; line-height: 1; color: #909399; cursor: pointer; }
.q-notification-close:hover { color: #606266; }
.q-notification-time { position: absolute; left: 0; bottom: 0; height: 2px; width: 100%; background: var(--q-tone); opacity: .6; transform-origin: left;
  animation-name: q-note-time; animation-timing-function: linear; animation-fill-mode: forwards; }
.q-notification:hover .q-notification-time { animation-play-state: paused; }
@keyframes q-note-time { from { transform: scaleX(1); } to { transform: scaleX(0); } }
.q-note-right-enter { animation: q-note-in-right .3s ease-out; }
.q-note-left-enter { animation: q-note-in-left .3s ease-out; }
.q-note-right-leave, .q-note-left-leave { animation: q-note-out .3s ease-in forwards; }
@keyframes q-note-in-right { from { opacity: 0; transform: translateX(100%); } }
@keyframes q-note-in-left { from { opacity: 0; transform: translateX(-100%); } }
@keyframes q-note-out { to { opacity: 0; } }
@media (prefers-reduced-motion: reduce) { .q-note-right-enter, .q-note-left-enter, .q-note-right-leave, .q-note-left-leave { animation-duration: .01s; } }
</style>"""


// ===== templates: parsing =====

struct _TNode {
    kind: String        // text, expr, raw, if, for, tag, comp, slot
    text: String        // the text / expression / tag name / iterable
    attrs: List         // tag, comp: [name, value] pairs
    children: List
    branches: List      // if: [condition, children] pairs
    otherwise: List     // if / for: the else part
    var1: String
    var2: String
    closed: Bool        // tag: written `<x ... />`

    define __init(self, kind: String, text: String = "") -> void {
        self.kind = kind
        self.text = text
        self.attrs = []
        self.children = []
        self.branches = []
        self.otherwise = []
        self.var1 = ""
        self.var2 = ""
        self.closed = false
    }
}

define _is_upper(c: String) -> Bool {
    return c != "" and c >= "A" and c <= "Z"
}

define _is_letter(c: String) -> Bool {
    return c != "" and ((c >= "a" and c <= "z") or (c >= "A" and c <= "Z"))
}

define _tfail(msg: String) -> void {
    throw ValueError("live template: " + msg)
}

// Index of the `>` closing the tag that starts at `at` (quotes respected).
define _tag_end(src: String, at: Int, n: Int) -> Int {
    j := at + 1
    quote := ""
    while j < n {
        c := web.byte_slice(src, j, 1)
        if quote != "" {
            if c == quote { quote = "" }
        } elif c == "\"" or c == "'" {
            quote = c
        } elif c == ">" {
            return j
        }
        j = j + 1
    }
    return -1
}

// A start tag the engine must rewrite: components, <slot>, <option>,
// @events, model=, :props.
define _special_tag(raw: String) -> Bool {
    first := web.byte_slice(raw, 0, 1)
    if _is_upper(first) or raw.startswith("slot") or raw.startswith("option") { return true }
    return raw.contains("@") or raw.contains(" model=") or raw.contains(" :")
}

// [kind, value]: text, expr ({{ }}), stmt ({% %}), open (a special start
// tag, without < >), close (a component's end tag: its name).
define _ttokens(src: String) -> List {
    out := []
    n := web.byte_length(src)
    i := 0
    start := 0
    while i < n {
        lt := web.byte_find(src, "<", i)
        ex := web.byte_find(src, "{{", i)
        st := web.byte_find(src, "{%", i)
        nxt := lt
        if ex >= 0 and (nxt < 0 or ex < nxt) { nxt = ex }
        if st >= 0 and (nxt < 0 or st < nxt) { nxt = st }
        if nxt < 0 { break }
        if nxt == ex or nxt == st {
            closer := nxt == ex ? "}}" : "%}"
            close := web.byte_find(src, closer, nxt + 2)
            if close < 0 { _tfail("'" + web.byte_slice(src, nxt, 2) + "' without '" + closer + "'") }
            if nxt > start { out.append(["text", web.byte_slice(src, start, nxt - start)]) }
            out.append([nxt == ex ? "expr" : "stmt", web.byte_slice(src, nxt + 2, close - nxt - 2).trim()])
            i = close + 2
            start = i
            continue
        }
        c := web.byte_slice(src, nxt + 1, 1)
        if _is_letter(c) {
            end := _tag_end(src, nxt, n)
            if end < 0 { _tfail("a tag without '>'") }
            raw := web.byte_slice(src, nxt + 1, end - nxt - 1)
            if _special_tag(raw) {
                if nxt > start { out.append(["text", web.byte_slice(src, start, nxt - start)]) }
                out.append(["open", raw])
                i = end + 1
                start = i
            } else {
                i = nxt + 1
            }
            continue
        }
        if c == "/" and (_is_upper(web.byte_slice(src, nxt + 2, 1)) or web.byte_slice(src, nxt + 2, 4) == "slot") {
            end := web.byte_find(src, ">", nxt)
            if nxt > start { out.append(["text", web.byte_slice(src, start, nxt - start)]) }
            out.append(["close", web.byte_slice(src, nxt + 2, end - nxt - 2).trim()])
            i = end + 1
            start = i
            continue
        }
        i = nxt + 1
    }
    if n > start { out.append(["text", web.byte_slice(src, start, n - start)]) }
    return out
}

// Parse a start tag's inside ("button @click='x' disabled") into a node.
define _tparse_tag(raw: String) -> _TNode {
    body := raw.trim()
    closed := body.endswith("/")
    if closed { body = web.byte_slice(body, 0, web.byte_length(body) - 1).trim() }
    n := web.byte_length(body)
    i := 0
    while i < n and not " \t\n\r".contains(web.byte_slice(body, i, 1)) { i = i + 1 }
    name := web.byte_slice(body, 0, i)
    node := _TNode(_is_upper(web.byte_slice(name, 0, 1)) ? "comp" : (name == "slot" ? "slot" : "tag"), name)
    node.closed = closed
    while i < n {
        c := web.byte_slice(body, i, 1)
        if " \t\n\r".contains(c) {
            i = i + 1
            continue
        }
        j := i
        while j < n and not " \t\n\r=".contains(web.byte_slice(body, j, 1)) { j = j + 1 }
        attr := web.byte_slice(body, i, j - i)
        value := ""
        has_value := false
        k := j
        while k < n and " \t\n\r".contains(web.byte_slice(body, k, 1)) { k = k + 1 }
        if k < n and web.byte_slice(body, k, 1) == "=" {
            has_value = true
            k = k + 1
            while k < n and " \t\n\r".contains(web.byte_slice(body, k, 1)) { k = k + 1 }
            q := web.byte_slice(body, k, 1)
            if q == "\"" or q == "'" {
                close := web.byte_find(body, q, k + 1)
                if close < 0 { close = n }
                value = web.byte_slice(body, k + 1, close - k - 1)
                j = close + 1
            } else {
                e := k
                while e < n and not " \t\n\r".contains(web.byte_slice(body, e, 1)) { e = e + 1 }
                value = web.byte_slice(body, k, e - k)
                j = e
            }
        }
        node.attrs.append([attr, value, has_value])
        i = j
    }
    return node
}

struct _TParser {
    toks: List
    pos: Int

    define __init(self, toks: List) -> void {
        self.toks = toks
        self.pos = 0
    }

    // Nodes up to a `{% stop %}` (one of `stops`) or a component end tag.
    define block(self, stops: List, closing: String) -> List {
        out := []
        while self.pos < self.toks.length() {
            t: List = self.toks[self.pos]
            kind: String = t[0]
            value: String = t[1]
            if kind == "close" {
                if value == closing { return out }
                _tfail("</" + value + "> without <" + value + ">")
            }
            if kind == "stmt" {
                word := _first_word(value)
                for s in stops {
                    stop: String = s
                    if word == stop { return out }
                }
            }
            self.pos = self.pos + 1
            if kind == "text" {
                out.append(_TNode("text", value))
            } elif kind == "expr" {
                if value.endswith("| raw") {
                    out.append(_TNode("raw", web.byte_slice(value, 0, web.byte_length(value) - 5).trim()))
                } else {
                    out.append(_TNode("expr", value))
                }
            } elif kind == "open" {
                node := _tparse_tag(value)
                if node.kind == "comp" and not node.closed {
                    node.children = self.block([], node.text)
                    self.pos = self.pos + 1           // the </Name>
                }
                out.append(node)
            } else {
                out.append(self.statement(value))
            }
        }
        if closing != "" { _tfail("<" + closing + "> without </" + closing + ">") }
        if stops.length() > 0 { _tfail("{% " + String(stops[0]) + " %} expected") }
        return out
    }

    define statement(self, value: String) -> _TNode {
        word := _first_word(value)
        rest := web.byte_slice(value, web.byte_length(word), web.byte_length(value) - web.byte_length(word)).trim()
        if word == "if" {
            node := _TNode("if")
            cond := rest
            while true {
                body := self.block(["elif", "else", "end"], "")
                node.branches.append([cond, body])
                t: List = self.toks[self.pos]
                v: String = t[1]
                self.pos = self.pos + 1
                w := _first_word(v)
                if w == "elif" {
                    cond = web.byte_slice(v, 4, web.byte_length(v) - 4).trim()
                } elif w == "else" {
                    node.otherwise = self.block(["end"], "")
                    self.pos = self.pos + 1
                    return node
                } else {
                    return node
                }
            }
        }
        if word == "for" {
            at := rest.find(" in ")
            if at < 0 { _tfail("{% for x in list %} expected, got {% " + value + " %}") }
            vars := rest.substring(0, at)
            node := _TNode("for", rest.substring(at + 4, rest.length()).trim())
            comma := vars.find(",")
            if comma >= 0 {
                node.var1 = vars.substring(0, comma).trim()
                node.var2 = vars.substring(comma + 1, vars.length()).trim()
            } else {
                node.var1 = vars.trim()
            }
            node.children = self.block(["else", "end"], "")
            t: List = self.toks[self.pos]
            v: String = t[1]
            self.pos = self.pos + 1
            if _first_word(v) == "else" {
                node.otherwise = self.block(["end"], "")
                self.pos = self.pos + 1
            }
            return node
        }
        _tfail("unknown {% " + value + " %}")
        return null
    }
}

define _first_word(s: String) -> String {
    sp := s.find(" ")
    return sp < 0 ? s : s.substring(0, sp)
}

_tpl_nodes := {}

define _parse_template(src: String) -> List {
    if _tpl_nodes.has(src) {
        cached: List = _tpl_nodes[src]
        return cached
    }
    p := _TParser(_ttokens(src))
    nodes := p.block([], "")
    _tpl_nodes[src] = nodes
    return nodes
}

// ===== templates: expressions =====

_expr_cache := {}

define _etokens(src: String) -> List {
    if _expr_cache.has(src) {
        cached: List = _expr_cache[src]
        return cached
    }
    out := []
    n := web.byte_length(src)
    i := 0
    while i < n {
        c := web.byte_slice(src, i, 1)
        if " \t\n\r".contains(c) {
            i = i + 1
        } elif c == "\"" or c == "'" {
            close := web.byte_find(src, c, i + 1)
            if close < 0 { _tfail("unclosed string in '" + src + "'") }
            out.append(["str", web.byte_slice(src, i + 1, close - i - 1)])
            i = close + 1
        } elif c >= "0" and c <= "9" {
            j := i
            while j < n and "0123456789.".contains(web.byte_slice(src, j, 1)) { j = j + 1 }
            out.append(["num", web.byte_slice(src, i, j - i)])
            i = j
        } elif _is_letter(c) or c == "_" {
            j := i
            while j < n {
                d := web.byte_slice(src, j, 1)
                if not (_is_letter(d) or d == "_" or (d >= "0" and d <= "9")) { break }
                j = j + 1
            }
            out.append(["id", web.byte_slice(src, i, j - i)])
            i = j
        } else {
            two := web.byte_slice(src, i, 2)
            if two == "==" or two == "!=" or two == "<=" or two == ">=" {
                out.append(["op", two])
                i = i + 2
            } elif "<>+-*/%(),.!".contains(c) {
                out.append(["op", c == "!" ? "not" : c])
                i = i + 1
            } else {
                _tfail("unexpected '" + c + "' in '" + src + "'")
            }
        }
    }
    _expr_cache[src] = out
    return out
}

// What a template's names resolve against: loop variables, then the
// component's fields and methods.
struct _Ctx {
    root: Component
    comp: Component
    scopes: List
    slot: List
    slot_ctx: _Ctx
    key: String
    counts: Map
    select_value: Any
    has_select: Bool
    root_key: String     // set until the component's first element is written: its q-key

    define __init(self, root: Component, comp: Component, key: String) -> void {
        self.root = root
        self.comp = comp
        self.scopes = []
        self.slot = []
        self.slot_ctx = null
        self.key = key
        self.counts = {}
        self.select_value = null
        self.has_select = false
        self.root_key = ""
    }

    define lookup(self, name: String) -> Any {
        i := self.scopes.length() - 1
        while i >= 0 {
            m: Map = self.scopes[i]
            if m.has(name) { return m[name] }
            i = i - 1
        }
        if name == "self" { return self.comp }
        if has_field(self.comp, name) { return get_field(self.comp, name) }
        if has_method(self.comp, name) { return call_method(self.comp, name, []) }
        _tfail("'" + name + "' isn't a field or method of " + type_name(self.comp))
        return null
    }

    define eval(self, src: String) -> Any {
        e := _Eval(_etokens(src), self, src)
        v := e.or_expr()
        if e.pos < e.toks.length() { _tfail("can't read '" + src + "'") }
        return v
    }
}

struct _Eval {
    toks: List
    pos: Int
    ctx: _Ctx
    src: String

    define __init(self, toks: List, ctx: _Ctx, src: String) -> void {
        self.toks = toks
        self.pos = 0
        self.ctx = ctx
        self.src = src
    }

    define peek(self) -> String {
        if self.pos >= self.toks.length() { return "" }
        t: List = self.toks[self.pos]
        k: String = t[0]
        v: String = t[1]
        if k == "str" or k == "num" { return "" }
        return v
    }

    define take(self, want: String) -> void {
        if self.peek() != want { _tfail("'" + want + "' expected in '" + self.src + "'") }
        self.pos = self.pos + 1
    }

    define or_expr(self) -> Any {
        v := self.and_expr()
        while self.peek() == "or" {
            self.pos = self.pos + 1
            r := self.and_expr()
            v = _truthy(v) or _truthy(r)
        }
        return v
    }

    define and_expr(self) -> Any {
        v := self.not_expr()
        while self.peek() == "and" {
            self.pos = self.pos + 1
            r := self.not_expr()
            v = _truthy(v) and _truthy(r)
        }
        return v
    }

    define not_expr(self) -> Any {
        if self.peek() == "not" {
            self.pos = self.pos + 1
            v := self.not_expr()
            return not _truthy(v)
        }
        return self.compare()
    }

    define compare(self) -> Any {
        v := self.sum()
        op := self.peek()
        if op == "==" or op == "!=" or op == "<" or op == ">" or op == "<=" or op == ">=" {
            self.pos = self.pos + 1
            r := self.sum()
            return _compare(v, op, r)
        }
        return v
    }

    define sum(self) -> Any {
        v := self.product()
        while self.peek() == "+" or self.peek() == "-" {
            op := self.peek()
            self.pos = self.pos + 1
            r := self.product()
            v = _arith(v, op, r)
        }
        return v
    }

    define product(self) -> Any {
        v := self.unary()
        while self.peek() == "*" or self.peek() == "/" or self.peek() == "%" {
            op := self.peek()
            self.pos = self.pos + 1
            r := self.unary()
            v = _arith(v, op, r)
        }
        return v
    }

    define unary(self) -> Any {
        if self.peek() == "-" {
            self.pos = self.pos + 1
            v := self.unary()
            return _arith(0, "-", v)
        }
        return self.postfix()
    }

    define args(self) -> List {
        out := []
        self.take("(")
        if self.peek() == ")" {
            self.pos = self.pos + 1
            return out
        }
        while true {
            out.append(self.or_expr())
            if self.peek() == "," {
                self.pos = self.pos + 1
            } else {
                self.take(")")
                return out
            }
        }
        return out
    }

    define postfix(self) -> Any {
        v := self.primary()
        while self.peek() == "." {
            self.pos = self.pos + 1
            t: List = self.toks[self.pos]
            name: String = t[1]
            self.pos = self.pos + 1
            if self.peek() == "(" {
                v = call_method(v, name, self.args())
            } else {
                v = _member(v, name)
            }
        }
        return v
    }

    define primary(self) -> Any {
        if self.pos >= self.toks.length() { _tfail("'" + self.src + "' ends too soon") }
        t: List = self.toks[self.pos]
        kind: String = t[0]
        value: String = t[1]
        self.pos = self.pos + 1
        if kind == "str" { return value }
        if kind == "num" {
            if value.contains(".") { return Double(value) }
            return Int(value)
        }
        if kind == "op" {
            if value == "(" {
                v := self.or_expr()
                self.take(")")
                return v
            }
            _tfail("unexpected '" + value + "' in '" + self.src + "'")
        }
        if value == "true" { return true }
        if value == "false" { return false }
        if value == "null" { return null }
        if self.peek() == "(" {
            return call_method(self.ctx.comp, value, self.args())
        }
        return self.ctx.lookup(value)
    }
}

define _member(v: Any, name: String) -> Any {
    if v == null { return null }
    if v is Map {
        m: Map = v
        if m.has(name) { return m[name] }
        if name == "length" { return m.keys().length() }
        return null
    }
    if v is List {
        l: List = v
        if name == "length" { return l.length() }
        _tfail("a List has no '" + name + "'")
    }
    if v is String {
        s: String = v
        if name == "length" { return s.length() }
        if name == "upper" { return s.upper() }
        if name == "lower" { return s.lower() }
        _tfail("a String has no '" + name + "'")
    }
    if has_field(v, name) { return get_field(v, name) }
    if has_method(v, name) { return call_method(v, name, []) }
    _tfail("'" + name + "' isn't a field of " + _describe(v))
    return null
}

// A value, for messages: "a TodoPage", "an Int (2)", "a Bool (true)".
define _describe(v: Any) -> String {
    t := type_name(v)
    if t != "" { return (("AEIOU".contains(t.substring(0, 1))) ? "an " : "a ") + t }
    if v is Int { return "an Int (" + _text(v) + ")" }
    if v is Double { return "a Double (" + _text(v) + ")" }
    if v is Bool { return "a Bool (" + _text(v) + ")" }
    return "a value (" + _text(v) + ")"
}

define _truthy(v: Any) -> Bool {
    if v == null { return false }
    if v is Bool {
        b: Bool = v
        return b
    }
    if v is Int {
        i: Int = v
        return i != 0
    }
    if v is Double {
        d: Double = v
        return d != 0.0
    }
    if v is String {
        s: String = v
        return s != ""
    }
    if v is List {
        l: List = v
        return l.length() > 0
    }
    if v is Map {
        m: Map = v
        return m.keys().length() > 0
    }
    return true
}

define _is_number(v: Any) -> Bool {
    return v is Int or v is Double
}

define _as_double(v: Any) -> Double {
    if v is Int {
        i: Int = v
        return Double(i)
    }
    d: Double = v
    return d
}

define _arith(a: Any, op: String, b: Any) -> Any {
    if op == "+" and (a is String or b is String) { return _text(a) + _text(b) }
    if not (_is_number(a) and _is_number(b)) { _tfail("can't " + op + " " + _text(a) + " and " + _text(b)) }
    if a is Int and b is Int and op != "/" {
        x: Int = a
        y: Int = b
        if op == "+" { return x + y }
        if op == "-" { return x - y }
        if op == "*" { return x * y }
        return x % y
    }
    x := _as_double(a)
    y := _as_double(b)
    if op == "+" { return x + y }
    if op == "-" { return x - y }
    if op == "*" { return x * y }
    if op == "/" { return x / y }
    return x - y * Double(Int(x / y))
}

define _equal(a: Any, b: Any) -> Bool {
    if a == null or b == null { return a == null and b == null }
    if _is_number(a) and _is_number(b) { return _as_double(a) == _as_double(b) }
    if a is String and b is String {
        x: String = a
        y: String = b
        return x == y
    }
    if a is Bool and b is Bool {
        p: Bool = a
        q: Bool = b
        return p == q
    }
    return a == b
}

define _compare(a: Any, op: String, b: Any) -> Bool {
    if op == "==" { return _equal(a, b) }
    if op == "!=" { return not _equal(a, b) }
    if _is_number(a) and _is_number(b) {
        x := _as_double(a)
        y := _as_double(b)
        if op == "<" { return x < y }
        if op == ">" { return x > y }
        if op == "<=" { return x <= y }
        return x >= y
    }
    if a is String and b is String {
        x: String = a
        y: String = b
        if op == "<" { return x < y }
        if op == ">" { return x > y }
        if op == "<=" { return x <= y }
        return x >= y
    }
    _tfail("can't compare " + _text(a) + " " + op + " " + _text(b))
    return false
}

// ===== templates: rendering =====

// `text` with every {{ expr }} replaced (escaped).
define _interpolate(text: String, ctx: _Ctx) -> String {
    if not text.contains("{{") { return text }
    out := ""
    rest := text
    while true {
        at := rest.find("{{")
        if at < 0 { break }
        close := rest.find("}}")
        if close < at { _tfail("'{{' without '}}' in '" + text + "'") }
        out = out + rest.substring(0, at) + _text(ctx.eval(rest.substring(at + 2, close).trim()))
        rest = rest.substring(close + 2, rest.length())
    }
    return out + rest
}

// A handler for an event: [component, method, args, pass_value] or
// [component, "=field"] for model=.
define _handler_for(spec: String, ctx: _Ctx) -> List {
    src := spec.trim()
    paren := src.find("(")
    if paren < 0 { return [ctx.comp, src, [], true] }
    name := src.substring(0, paren).trim()
    e := _Eval(_etokens(src.substring(paren, src.length())), ctx, src)
    args := e.args()
    return [ctx.comp, name, args, false]
}

define _register(ctx: _Ctx, h: List) -> String {
    root := ctx.root
    root._next = root._next + 1
    id := "h" + String(root._next)
    root._handlers[id] = h
    return id
}

_events := {"click": "q-click", "submit": "q-submit", "input": "q-input", "change": "q-change", "enter": "q-enter", "after": "q-after"}

define _render_tag(node: _TNode, ctx: _Ctx) -> String {
    out := "<" + node.text
    attrs := ""
    events := {}                    // q-attribute → [handler ids]
    is_checkbox := false
    for a in node.attrs {
        at: List = a
        n: String = at[0]
        if n == "type" and String(at[1]) == "checkbox" { is_checkbox = true }
    }
    for a in node.attrs {
        at: List = a
        name: String = at[0]
        value: String = at[1]
        has_value: Bool = at[2]
        if name.startswith("@") {
            ev := name.substring(1, name.length())
            if not _events.has(ev) { _tfail("unknown event @" + ev + " (use @click, @submit, @input, @change, @enter or @after)") }
            q: String = _events[ev]
            if not events.has(q) { events[q] = [] }
            ids: List = events[q]
            ids.append(_register(ctx, _handler_for(value, ctx)))
        } elif name == "model" {
            current := ctx.lookup(value)
            q := is_checkbox ? "q-change" : (node.text == "select" ? "q-change" : "q-input")
            if not events.has(q) { events[q] = [] }
            ids: List = events[q]
            ids.append(_register(ctx, [ctx.comp, "=" + value]))
            if is_checkbox {
                if _truthy(current) { attrs = attrs + " checked" }
            } elif node.text == "select" {
                ctx.select_value = current
                ctx.has_select = true
            } elif node.text != "textarea" {
                attrs = attrs + " value=\"" + web.escape(_text(current)) + "\""
            }
        } elif name.startswith(":") {
            attr := name.substring(1, name.length())
            v := ctx.eval(value)
            if v is Bool {
                b: Bool = v
                if b { attrs = attrs + " " + attr }
            } elif v != null {
                attrs = attrs + " " + attr + "=\"" + web.escape(_text(v)) + "\""
            }
        } elif has_value {
            attrs = attrs + " " + name + "=\"" + web.escape(_interpolate(value, ctx)) + "\""
        } else {
            attrs = attrs + " " + name
        }
    }
    if node.text == "option" and ctx.has_select {
        for a in node.attrs {
            at: List = a
            name: String = at[0]
            if name == "value" and _equal(_interpolate(String(at[1]), ctx), _text(ctx.select_value)) {
                attrs = attrs + " selected"
            }
        }
    }
    // A component's first element carries its key: the browser matches it
    // by key when the page changes (moved, not rewritten — a list keeps
    // each item's own element).
    if ctx.root_key != "" {
        attrs = attrs + " q-key=\"" + web.escape(ctx.root_key) + "\""
        ctx.root_key = ""
    }
    // @after: the browser runs it `delay` ms after the element appears. The
    // timer belongs to this component (its key), not to a DOM position.
    if events.has("q-after") {
        n := ctx.counts.has("@after") ? Int(ctx.counts["@after"]) : 0
        ctx.counts["@after"] = n + 1
        // (the page's id too: another visit to the page has the same keys)
        attrs = attrs + " q-after-key=\"" + web.escape(ctx.root.id + ctx.key + "@" + String(n)) + "\""
    }
    for q in events.keys() {
        qn: String = q
        ids: List = events[qn]
        joined := ""
        for id in ids { joined = joined == "" ? String(id) : joined + " " + String(id) }
        attrs = attrs + " " + qn + "=\"" + joined + "\""
    }
    return out + attrs + (node.closed ? " />" : ">")
}

define _render_comp(node: _TNode, ctx: _Ctx) -> String {
    root := ctx.root
    name := node.text
    key := ""
    for a in node.attrs {
        at: List = a
        an: String = at[0]
        if an == "key" { key = _interpolate(String(at[1]), ctx) }
        if an == ":key" { key = _text(ctx.eval(String(at[1]))) }
    }
    if key == "" {
        n := ctx.counts.has(name) ? Int(ctx.counts[name]) : 0
        ctx.counts[name] = n + 1
        key = ctx.key + "/" + name + "#" + String(n)
    } else {
        key = ctx.key + "/" + name + "=" + key
    }
    fresh := false
    if not root._children.has(key) {
        made := new_struct(name)
        if made == null { _tfail("<" + name + "> isn't a struct of this app") }
        if not has_field(made, "_root") { _tfail("<" + name + "> isn't a live.Component") }
        root._children[key] = made
        fresh = true
    }
    root._seen[key] = true
    child: Component = root._children[key]
    child._root = root
    child._parent = ctx.comp
    if child._listeners == null { child._listeners = {} }
    for a in node.attrs {
        at: List = a
        an: String = at[0]
        value: String = at[1]
        if an == "key" or an == ":key" { continue }
        if an.startswith("@") {
            child._listeners[an.substring(1, an.length())] = _handler_for(value, ctx)
        } elif an.startswith(":") {
            _set_prop(child, an.substring(1, an.length()), ctx.eval(value))
        } else {
            _set_prop(child, an, _interpolate(value, ctx))
        }
    }
    if fresh { child._start() }
    inner := _Ctx(root, child, key)
    inner.root_key = key
    inner.slot = node.children
    inner.slot_ctx = ctx
    return _render_nodes(_parse_template(_template_of(child)), inner)
}

// Set field `name` of `obj` to `value`, converting text to the field's
// declared type (a prop `count="3"`, a model input's text).
define _set_prop(obj: Any, name: String, value: Any) -> void {
    if not has_field(obj, name) { return }           // class=, id= ... on a component: ignored
    kind := field_type(obj, name)
    v := value
    if value is String {
        s: String = value
        if kind == "Int" {
            v = s.trim() == "" ? 0 : Int(s.trim())
        } elif kind == "Double" {
            v = s.trim() == "" ? 0.0 : Double(s.trim())
        } elif kind == "Bool" {
            v = s == "true" or s == "on" or s == "1"
        }
    } elif kind == "String" and value != null {
        v = _text(value)
    }
    set_field(obj, name, v)
}

define _render_nodes(nodes: List, ctx: _Ctx) -> String {
    out := ""
    for n in nodes {
        node: _TNode = n
        k := node.kind
        if k == "text" {
            out = out + node.text
        } elif k == "expr" {
            out = out + web.escape(_text(ctx.eval(node.text)))
        } elif k == "raw" {
            out = out + _text(ctx.eval(node.text))
        } elif k == "if" {
            done := false
            for b in node.branches {
                br: List = b
                if not done and _truthy(ctx.eval(String(br[0]))) {
                    out = out + _render_nodes(br[1], ctx)
                    done = true
                }
            }
            if not done { out = out + _render_nodes(node.otherwise, ctx) }
        } elif k == "for" {
            items := ctx.eval(node.text)
            count := 0
            if items is Map {
                m: Map = items
                for key in m.keys() {
                    scope := {}
                    scope[node.var1] = key
                    if node.var2 != "" { scope[node.var2] = m[String(key)] }
                    ctx.scopes.append(scope)
                    out = out + _render_nodes(node.children, ctx)
                    ctx.scopes.pop()
                    count = count + 1
                }
            } elif items != null {
                l: List = items
                i := 0
                for it in l {
                    scope := {}
                    if node.var2 != "" {
                        scope[node.var1] = i
                        scope[node.var2] = it
                    } else {
                        scope[node.var1] = it
                    }
                    ctx.scopes.append(scope)
                    out = out + _render_nodes(node.children, ctx)
                    ctx.scopes.pop()
                    i = i + 1
                }
                count = i
            }
            if count == 0 { out = out + _render_nodes(node.otherwise, ctx) }
        } elif k == "tag" {
            out = out + _render_tag(node, ctx)
        } elif k == "comp" {
            out = out + _render_comp(node, ctx)
        } elif k == "slot" {
            if ctx.slot_ctx != null { out = out + _render_nodes(ctx.slot, ctx.slot_ctx) }
        }
    }
    return out
}

_tpl_files := {}

define _snake(name: String) -> String {
    out := ""
    n := web.byte_length(name)
    i := 0
    while i < n {
        c := web.byte_slice(name, i, 1)
        if _is_upper(c) {
            if i > 0 { out = out + "_" }
            out = out + c.lower()
        } else {
            out = out + c
        }
        i = i + 1
    }
    return out
}

// The component's template: template(), or its .html file (re-read when it changes).
define _template_of(comp: Component) -> String {
    own := comp.template()
    if own != "" { return own }
    tname := type_name(comp)
    src := source_file(comp)
    dir := fs.dirname(src)
    candidates := [fs.join(dir, _snake(tname) + ".html")]
    base := fs.basename(src)
    dot := base.find(".")
    if dot > 0 { candidates.append(fs.join(dir, base.substring(0, dot) + ".html")) }
    for c in candidates {
        path: String = c
        if fs.is_file(path) {
            stamp := String(fs.mtime(path)) + ":" + String(fs.size(path))
            if _tpl_files.has(path) {
                entry: List = _tpl_files[path]
                if String(entry[0]) == stamp {
                    text: String = entry[1]
                    return text
                }
            }
            text := fs.read_text(path)
            _tpl_files[path] = [stamp, text]
            return text
        }
    }
    _tfail("no template for " + tname + ": add " + String(candidates[0]) + ", or define template(self) -> String")
    return ""
}

// Render a root component (a page): its handlers and child components are
// numbered afresh; children not shown any more are dropped.
define _render_root(comp: Component) -> String {
    if comp._handlers == null { comp._handlers = {} }
    if comp._children == null { comp._children = {} }
    comp._root = comp
    comp._handlers = {}
    comp._seen = {}
    comp._next = 0
    out := _render_nodes(_parse_template(_template_of(comp)), _Ctx(comp, comp, ""))
    kept := {}
    for k in comp._children.keys() {
        key: String = k
        if comp._seen.has(key) { kept[key] = comp._children[key] }
    }
    comp._children = kept
    return out
}

define _run_handler(h: List, value: Any, pass_value: Bool) -> void {
    target := h[0]
    method: String = h[1]
    if method.startswith("=") {
        _set_prop(target, method.substring(1, method.length()), value)
        return
    }
    args: List = h[2]
    explicit: Bool = h[3]
    if explicit and pass_value {
        call_method(target, method, [value])
    } else {
        call_method(target, method, args)
    }
}

// An event from the page: `h3` (or several, space-separated) → its handler.
define _dispatch(root: Component, event: String, data: Map) -> void {
    if root._handlers == null { return }
    for part in event.split(" ") {
        id: String = part
        if not root._handlers.has(id) { continue }
        h: List = root._handlers[id]
        value: Any = null
        has := false
        method: String = h[1]
        if data.has("value") {
            value = data["value"]
            has = true
        } elif not method.startswith("=") and data.keys().length() > 0 {
            value = data                       // a form's fields
            has = true
        }
        _run_handler(h, value, has)
    }
}

// ===== widgets =====

---
Something on a page. The built-in widgets (Label, Button, TextInput,
Column, ...) render themselves; for one of your own, subclass Widget and
return what it's made of from `build()`:

    struct TodoItem : live.Widget {
        text: String
        define build(self) -> live.Widget {
            return live.Row([live.Label(self.text), live.Button("×")])
        }
    }

`with_class("name")` / `with_style("css")` add a CSS class / inline
style (they return the widget, so they chain).
---
struct Widget {
    _id: String
    _class: String
    _style: String

    define __init(self) -> void {
        self._id = ""
        self._class = ""
        self._style = ""
    }

    --- What this widget is made of (override for a widget of your own). ---
    define build(self) -> Widget {
        return null
    }

    --- Add a CSS class. ---
    define with_class(self, name: String) -> Widget {
        self._class = self._class == "" ? name : self._class + " " + name
        return self
    }

    --- Add inline CSS ("color: red"). ---
    define with_style(self, css: String) -> Widget {
        self._style = self._style == "" ? css : self._style + ";" + css
        return self
    }

    // Its HTML; `b` gives ids to the widgets inside.
    define _html(self, b: _Build) -> String {
        return b.render(self.build())
    }

    // An event from the browser: `kind` ("click", "change", ...), `data` its values.
    define _event(self, kind: String, data: Map) -> void {
    }

    // The text TestSession finds it by.
    define _label(self) -> String {
        return ""
    }

    // class / style attributes, with `style` first.
    define _attrs(self, style: String = "") -> String {
        out := ""
        if self._class != "" { out = out + " class=\"" + web.escape(self._class) + "\"" }
        css := style
        if self._style != "" { css = css == "" ? self._style : css + ";" + self._style }
        if css != "" { out = out + " style=\"" + web.escape(css) + "\"" }
        return out
    }

    // The event name the browser sends for `kind`.
    define _on(self, kind: String) -> String {
        return self._id + ":" + kind
    }
}

// One build of a page: numbers the widgets, so an event finds its widget.
struct _Build {
    n: Int
    widgets: Map

    define __init(self) -> void {
        self.n = 0
        self.widgets = {}
    }

    define render(self, w: Widget) -> String {
        if w == null { return "" }
        self.n = self.n + 1
        w._id = "w" + String(self.n)
        self.widgets[w._id] = w
        return w._html(self)
    }

    // Widgets, or plain values (shown as text).
    define all(self, items: List) -> String {
        out := ""
        for it in items { out = out + self.item(it) }
        return out
    }

    define item(self, it: Any) -> String {
        if it == null { return "" }
        if it is String or it is Int or it is Double or it is Bool { return web.escape(String(it)) }
        w: Widget = it
        return self.render(w)
    }
}

define _text(it: Any) -> String {
    if it == null { return "" }
    return String(it)
}

--- A line of text. ---
struct Label : Widget {
    text: String

    define __init(self, text: String) -> void {
        super().__init()
        self.text = text
    }

    define _html(self, b: _Build) -> String {
        return "<p" + self._attrs() + ">" + web.escape(self.text) + "</p>"
    }

    define _label(self) -> String {
        return self.text
    }
}

--- A title: `level` 1 (largest) to 6. ---
struct Heading : Widget {
    text: String
    level: Int

    define __init(self, text: String, level: Int = 1) -> void {
        super().__init()
        self.text = text
        self.level = level < 1 ? 1 : (level > 6 ? 6 : level)
    }

    define _html(self, b: _Build) -> String {
        tag := "h" + String(self.level)
        return "<" + tag + self._attrs() + ">" + web.escape(self.text) + "</" + tag + ">"
    }

    define _label(self) -> String {
        return self.text
    }
}

---
HTML of your own, as is (not escaped — don't put user input in it
unescaped; `live.html(template, data)` escapes for you).
---
struct Html : Widget {
    source: String

    define __init(self, source: String) -> void {
        super().__init()
        self.source = source
    }

    define _html(self, b: _Build) -> String {
        return self.source
    }
}

---
A button. `on_click()` runs when it's clicked — pass `on_click=fn() {...}`,
or subclass Button and override `on_click(self)`.
---
struct Button : Widget {
    text: String
    _click: Callable

    define __init(self, text: String, on_click: Callable = null) -> void {
        super().__init()
        self.text = text
        self._click = on_click
    }

    --- Runs on a click (override, or pass `on_click=`). ---
    define on_click(self) -> void {
        if self._click != null { self._click() }
    }

    define _event(self, kind: String, data: Map) -> void {
        if kind == "click" { self.on_click() }
    }

    define _html(self, b: _Build) -> String {
        return "<button type=\"button\"" + self._attrs() + " q-click=\"" + self._on("click") + "\">" + web.escape(self.text) + "</button>"
    }

    define _label(self) -> String {
        return self.text
    }
}

---
A link to another page. Between live pages it switches without a reload
(Back / Forward work); `external=true` for a normal link (another site).
---
struct Link : Widget {
    text: String
    href: String
    external: Bool

    define __init(self, text: String, href: String, external: Bool = false) -> void {
        super().__init()
        self.text = text
        self.href = href
        self.external = external
    }

    define _html(self, b: _Build) -> String {
        nav := self.external ? "" : " q-link"
        return "<a href=\"" + web.escape(self.href) + "\"" + self._attrs() + nav + ">" + web.escape(self.text) + "</a>"
    }

    define _label(self) -> String {
        return self.text
    }
}

--- A picture; `alt` describes it (for screen readers). ---
struct Image : Widget {
    src: String
    alt: String

    define __init(self, src: String, alt: String = "") -> void {
        super().__init()
        self.src = src
        self.alt = alt
    }

    define _html(self, b: _Build) -> String {
        return "<img src=\"" + web.escape(self.src) + "\" alt=\"" + web.escape(self.alt) + "\"" + self._attrs() + ">"
    }
}

---
A one-line text field. `on_change(text)` runs as the user types (after a
short pause), `on_submit(text)` on Enter. Show the page's state in it
(`text=self.draft`); set that to "" in on_submit to clear the field.
---
struct TextInput : Widget {
    text: String
    placeholder: String
    password: Bool
    _change: Callable
    _submit: Callable

    define __init(self, text: String = "", placeholder: String = "", on_change: Callable = null, on_submit: Callable = null, password: Bool = false) -> void {
        super().__init()
        self.text = text
        self.placeholder = placeholder
        self.password = password
        self._change = on_change
        self._submit = on_submit
    }

    --- Runs as the text changes (override, or pass `on_change=`). ---
    define on_change(self, text: String) -> void {
        if self._change != null { self._change(text) }
    }

    --- Runs on Enter (override, or pass `on_submit=`). ---
    define on_submit(self, text: String) -> void {
        if self._submit != null { self._submit(text) }
    }

    define _event(self, kind: String, data: Map) -> void {
        value := _text(data["value"])
        self.text = value
        if kind == "change" { self.on_change(value) }
        if kind == "submit" { self.on_submit(value) }
    }

    define _html(self, b: _Build) -> String {
        kind := self.password ? "password" : "text"
        out := "<input type=\"" + kind + "\" value=\"" + web.escape(self.text) + "\""
        if self.placeholder != "" {
            ph := web.escape(self.placeholder)
            out = out + " placeholder=\"" + ph + "\" aria-label=\"" + ph + "\""
        }
        return out + self._attrs() + " q-input=\"" + self._on("change") + "\" q-enter=\"" + self._on("submit") + "\">"
    }

    define _label(self) -> String {
        return self.placeholder
    }
}

--- A text field of several lines; `on_change(text)` as the user types. ---
struct TextArea : Widget {
    text: String
    rows: Int
    placeholder: String
    _change: Callable

    define __init(self, text: String = "", rows: Int = 4, on_change: Callable = null, placeholder: String = "") -> void {
        super().__init()
        self.text = text
        self.rows = rows
        self.placeholder = placeholder
        self._change = on_change
    }

    --- Runs as the text changes (override, or pass `on_change=`). ---
    define on_change(self, text: String) -> void {
        if self._change != null { self._change(text) }
    }

    define _event(self, kind: String, data: Map) -> void {
        value := _text(data["value"])
        self.text = value
        if kind == "change" { self.on_change(value) }
    }

    define _html(self, b: _Build) -> String {
        out := "<textarea rows=\"" + String(self.rows) + "\""
        if self.placeholder != "" {
            ph := web.escape(self.placeholder)
            out = out + " placeholder=\"" + ph + "\" aria-label=\"" + ph + "\""
        }
        return out + self._attrs() + " q-input=\"" + self._on("change") + "\">" + web.escape(self.text) + "</textarea>"
    }

    define _label(self) -> String {
        return self.placeholder
    }
}

--- A box that's ticked or not, with a label; `on_change(checked)` when it's clicked. ---
struct Checkbox : Widget {
    text: String
    checked: Bool
    _change: Callable

    define __init(self, text: String, checked: Bool = false, on_change: Callable = null) -> void {
        super().__init()
        self.text = text
        self.checked = checked
        self._change = on_change
    }

    --- Runs when it's ticked or unticked (override, or pass `on_change=`). ---
    define on_change(self, checked: Bool) -> void {
        if self._change != null { self._change(checked) }
    }

    define _event(self, kind: String, data: Map) -> void {
        if kind != "change" { return }
        self.checked = _text(data["value"]) == "true"
        self.on_change(self.checked)
    }

    define _html(self, b: _Build) -> String {
        tick := self.checked ? " checked" : ""
        return "<label" + self._attrs() + "><input type=\"checkbox\"" + tick + " q-change=\"" + self._on("change") + "\"> " + web.escape(self.text) + "</label>"
    }

    define _label(self) -> String {
        return self.text
    }
}

---
A list to pick one of `options` from; `selected` is the index shown.
`on_change(index, option)` when another is picked.
---
struct Dropdown : Widget {
    options: List
    selected: Int
    _change: Callable

    define __init(self, options: List, selected: Int = 0, on_change: Callable = null) -> void {
        super().__init()
        self.options = options
        self.selected = selected
        self._change = on_change
    }

    --- Runs when another option is picked (override, or pass `on_change=`). ---
    define on_change(self, index: Int, option: Any) -> void {
        if self._change != null { self._change(index, option) }
    }

    define _event(self, kind: String, data: Map) -> void {
        if kind != "change" { return }
        i := Int(_text(data["value"]))
        if i < 0 or i >= self.options.length() { return }
        self.selected = i
        self.on_change(i, self.options[i])
    }

    define _html(self, b: _Build) -> String {
        out := "<select" + self._attrs() + " q-change=\"" + self._on("change") + "\">"
        i := 0
        for o in self.options {
            sel := i == self.selected ? " selected" : ""
            out = out + "<option value=\"" + String(i) + "\"" + sel + ">" + web.escape(_text(o)) + "</option>"
            i = i + 1
        }
        return out + "</select>"
    }

    define _label(self) -> String {
        if self.options.length() == 0 { return "" }
        return _text(self.options[0])
    }
}

--- A number picked with a handle; `on_change(value)` when it's moved. ---
struct Slider : Widget {
    min: Int
    max: Int
    value: Int
    step: Int
    _change: Callable

    define __init(self, min: Int = 0, max: Int = 100, value: Int = 50, on_change: Callable = null, step: Int = 1) -> void {
        super().__init()
        self.min = min
        self.max = max
        self.value = value
        self.step = step
        self._change = on_change
    }

    --- Runs when the value changes (override, or pass `on_change=`). ---
    define on_change(self, value: Int) -> void {
        if self._change != null { self._change(value) }
    }

    define _event(self, kind: String, data: Map) -> void {
        if kind != "change" { return }
        self.value = Int(_text(data["value"]))
        self.on_change(self.value)
    }

    define _html(self, b: _Build) -> String {
        return "<input type=\"range\" min=\"" + String(self.min) + "\" max=\"" + String(self.max) + "\" step=\"" + String(self.step) +
               "\" value=\"" + String(self.value) + "\"" + self._attrs() + " q-change=\"" + self._on("change") + "\">"
    }
}

--- Widgets one above the other, `spacing` pixels apart. ---
struct Column : Widget {
    children: List
    spacing: Int

    define __init(self, children: List, spacing: Int = 8) -> void {
        super().__init()
        self.children = children
        self.spacing = spacing
    }

    define _html(self, b: _Build) -> String {
        css := "display:flex;flex-direction:column;gap:" + String(self.spacing) + "px"
        return "<div" + self._attrs(css) + ">" + b.all(self.children) + "</div>"
    }
}

--- Widgets side by side, `spacing` pixels apart (wrapping when the window is narrow). ---
struct Row : Widget {
    children: List
    spacing: Int

    define __init(self, children: List, spacing: Int = 8) -> void {
        super().__init()
        self.children = children
        self.spacing = spacing
    }

    define _html(self, b: _Build) -> String {
        css := "display:flex;flex-wrap:wrap;align-items:center;gap:" + String(self.spacing) + "px"
        return "<div" + self._attrs(css) + ">" + b.all(self.children) + "</div>"
    }
}

--- Empty space that pushes the widgets after it in a Row to the end. ---
struct Spacer : Widget {
    define _html(self, b: _Build) -> String {
        return "<div" + self._attrs("flex:1") + "></div>"
    }
}

---
A bulleted list of `items` — text, or widgets. With `on_select`, an item
can be clicked: `on_select(index, item)`.
---
struct ListView : Widget {
    items: List
    _select: Callable

    define __init(self, items: List, on_select: Callable = null) -> void {
        super().__init()
        self.items = items
        self._select = on_select
    }

    --- Runs when an item is clicked (override, or pass `on_select=`). ---
    define on_select(self, index: Int, item: Any) -> void {
        if self._select != null { self._select(index, item) }
    }

    define _event(self, kind: String, data: Map) -> void {
        if kind != "select" { return }
        i := Int(_text(data["value"]))
        if i < 0 or i >= self.items.length() { return }
        self.on_select(i, self.items[i])
    }

    define _html(self, b: _Build) -> String {
        out := "<ul" + self._attrs() + ">"
        i := 0
        for it in self.items {
            if self._select != null {
                out = out + "<li q-value=\"" + String(i) + "\" q-click=\"" + self._on("select") + "\">" + b.item(it) + "</li>"
            } else {
                out = out + "<li>" + b.item(it) + "</li>"
            }
            i = i + 1
        }
        return out + "</ul>"
    }
}

---
A table: `columns` the header texts, `rows` a List of rows (each a List of
cells — text or widgets). With `on_select`, a row can be clicked:
`on_select(index, row)`.
---
struct Table : Widget {
    columns: List
    rows: List
    _select: Callable

    define __init(self, columns: List, rows: List, on_select: Callable = null) -> void {
        super().__init()
        self.columns = columns
        self.rows = rows
        self._select = on_select
    }

    --- Runs when a row is clicked (override, or pass `on_select=`). ---
    define on_select(self, index: Int, row: List) -> void {
        if self._select != null { self._select(index, row) }
    }

    define _event(self, kind: String, data: Map) -> void {
        if kind != "select" { return }
        i := Int(_text(data["value"]))
        if i < 0 or i >= self.rows.length() { return }
        row: List = self.rows[i]
        self.on_select(i, row)
    }

    define _html(self, b: _Build) -> String {
        out := "<table" + self._attrs() + "><thead><tr>"
        for c in self.columns { out = out + "<th>" + b.item(c) + "</th>" }
        out = out + "</tr></thead><tbody>"
        i := 0
        for r in self.rows {
            row: List = r
            if self._select != null {
                out = out + "<tr q-value=\"" + String(i) + "\" q-click=\"" + self._on("select") + "\">"
            } else {
                out = out + "<tr>"
            }
            for cell in row { out = out + "<td>" + b.item(cell) + "</td>" }
            out = out + "</tr>"
            i = i + 1
        }
        return out + "</tbody></table>"
    }
}

// ===== pages =====

---
A page: a Component the router serves (`router.add("/todos", TodoPage)`).
Write its HTML in `template()`, or build it from widgets by overriding
`build()`:

    define build(self) -> live.Widget {
        return live.Column([
            live.Label("Count: " + String(self.count)),
            live.Button("+1", on_click=fn() { self.count = self.count + 1 }),
        ])
    }
---
struct Page : Component {
    _widgets: Map

    define __init(self) -> void {
        super().__init()
        self._widgets = {}
    }

    --- What the page shows, built from widgets (override) — or leave it, and write a template. ---
    define build(self) -> Widget {
        return null
    }

    define render(self) -> String {
        root := self.build()
        if root == null { return _render_root(self) }
        b := _Build()
        out := b.render(root)
        self._widgets = b.widgets
        return out
    }

    define _widget(self, text: String) -> Widget {
        if self._widgets == null { return null }
        i := 1
        while self._widgets.has("w" + String(i)) {
            w: Widget = self._widgets["w" + String(i)]
            if w._label() == text { return w }
            i = i + 1
        }
        return null
    }

    define handle(self, event: String, data: Map) -> void {
        at := event.find(":")
        if at < 0 {
            _dispatch(self, event, data)
            return
        }
        id := event.substring(0, at)
        if self._widgets == null or not self._widgets.has(id) { return }
        w: Widget = self._widgets[id]
        w._event(event.substring(at + 1, event.length()), data)
    }
}

// ===== templates =====

_templates := {}

---
`template` (web's template syntax: `{{ value }}`, `{% if %}`, `{% for %}`
...) rendered with `data` — escaped, so user input can't inject HTML.
Templates are parsed once and cached.
---
define html(template: String, data: Map = {}) -> String {
    if not _templates.has(template) {
        _templates[template] = web.Template(template)
    }
    t: web.Template = _templates[template]
    return t.render(data)
}

// ===== sessions =====

// id → [component, last used (ms)]
_sessions := {}
_session_ttl_ms := [30 * 60 * 1000]

define _store(comp: Component) -> String {
    _sweep()
    id := crypto.random_hex(16)
    comp.id = id
    _sessions[id] = [comp, web.now() * 1000]
    return id
}

// Forget components unused for longer than the time-to-live.
define _sweep() -> void {
    now := web.now() * 1000
    ttl: Int = _session_ttl_ms[0]
    stale := []
    for k in _sessions.keys() {
        key: String = k
        entry: List = _sessions[key]
        last: Int = entry[1]
        if now - last > ttl { stale.append(key) }
    }
    for k in stale {
        key: String = k
        _sessions.remove(key)
    }
}

define _find(id: String) -> Component {
    if not _sessions.has(id) { return null }
    entry: List = _sessions[id]
    entry[1] = web.now() * 1000
    c: Component = entry[0]
    return c
}

--- How long a page's component is kept after its last event (minutes; default 30). ---
define session_minutes(minutes: Int) -> void {
    _session_ttl_ms[0] = minutes * 60 * 1000
}

--- The number of live components the server is holding (open pages). ---
define session_count() -> Int {
    return _sessions.keys().length()
}

// ===== the browser side (fixed; you never edit it) =====

_client_js := """(function () {
  function post(url, body) {
    return fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) })
      .then(function (r) { return r.json(); });
  }
  function rootOf(el) { return el && el.closest ? el.closest('[q-root]') : null; }
  function dataOf(el) {
    var d = {}, k;
    for (k in el.dataset) d[k] = el.dataset[k];
    if (el.hasAttribute('q-value')) d.value = el.getAttribute('q-value');
    else if (el.type === 'checkbox' || el.type === 'radio') d.value = String(el.checked);
    else if ('value' in el && el.type !== 'submit' && el.type !== 'button') d.value = el.value;
    return d;
  }
  var queue = Promise.resolve(), forced = null;
  function send(el, event, data, force) {
    var root = rootOf(el);
    if (!root || !event) return;
    queue = queue.then(function () {
      return post('/_live/event', { id: root.getAttribute('q-root'), event: event, data: data })
        .then(function (res) { forced = force || null; apply(root, res); forced = null; });
    }).catch(function (err) { forced = null; console.error('live:', err); });
  }
  function apply(root, res) {
    if (res.reload) { location.reload(); return; }
    if (res.redirect) { navigate(res.redirect, true); return; }
    if (typeof res.html === 'string') morph(root, res.html);
    if (res.title) document.title = res.title;
    startTimers();
  }
  function morph(root, html) {
    var t = document.createElement('div');
    t.innerHTML = html;
    patchChildren(root, t);
  }
  function keyOf(n) { return n && n.nodeType === 1 ? n.getAttribute('q-key') : null; }
  // q-transition="name": a new element gets name-enter until its animation
  // ends; one going away gets name-leave and is removed when it ends.
  function entered(n) {
    if (n.nodeType !== 1) return;
    var list = [n].concat([].slice.call(n.querySelectorAll('[q-transition]'))), i;
    for (i = 0; i < list.length; i++) {
      (function (el) {
        var name = el.getAttribute('q-transition');
        if (!name) return;
        el.classList.add(name + '-enter');
        var done = function () { el.classList.remove(name + '-enter'); };
        el.addEventListener('animationend', done, { once: true });
        setTimeout(done, 1500);
      })(list[i]);
    }
  }
  function leave(n) {
    var name = n.nodeType === 1 ? n.getAttribute('q-transition') : null;
    // No transition of its own, but some inside it (the last notification of
    // a corner, whose box goes too): their leave plays, then it goes.
    var inside = !name && n.nodeType === 1 ? n.querySelectorAll('[q-transition]') : [];
    if (!name && inside.length === 0) { n.parentNode.removeChild(n); return; }
    n.setAttribute('q-leaving', '');
    var gone = false, done = function () { if (!gone && n.parentNode) { gone = true; n.parentNode.removeChild(n); } };
    var parts = name ? [n] : [].slice.call(inside), i, left = parts.length;
    for (i = 0; i < parts.length; i++) {
      (function (el) {
        var nm = el.getAttribute('q-transition');
        el.setAttribute('q-leaving', '');
        el.classList.remove(nm + '-enter');
        el.classList.add(nm + '-leave');
        el.addEventListener('animationend', function () { if (--left === 0) done(); }, { once: true });
      })(parts[i]);
    }
    setTimeout(done, 1500);
  }
  function alive(a) {
    var out = [], i, c;
    for (i = 0; i < a.childNodes.length; i++) {
      c = a.childNodes[i];
      if (!(c.nodeType === 1 && c.hasAttribute('q-leaving'))) out.push(c);
    }
    return out;
  }
  function patchChildren(a, b) {
    var i, k, bc = [].slice.call(b.childNodes), kids, want, cur, key, match, n;
    for (i = 0; i < bc.length; i++) {
      kids = alive(a);
      want = bc[i];
      cur = kids[i] || null;
      key = keyOf(want);
      if (key) {
        // A component's element: the one with its key, moved here if need be.
        match = null;
        for (k = i; k < kids.length; k++) if (keyOf(kids[k]) === key) { match = kids[k]; break; }
        if (match) {
          if (match !== cur) a.insertBefore(match, cur);
          patch(match, want);
        } else {
          n = want.cloneNode(true);
          a.insertBefore(n, cur);
          entered(n);
        }
        continue;
      }
      if (!cur || keyOf(cur)) {
        n = want.cloneNode(true);
        a.insertBefore(n, cur);
        entered(n);
      } else {
        patch(cur, want);
      }
    }
    kids = alive(a);
    for (i = kids.length - 1; i >= bc.length; i--) leave(kids[i]);
  }
  function patch(a, b) {
    if (a.nodeType !== b.nodeType || a.nodeName !== b.nodeName) { a.parentNode.replaceChild(b.cloneNode(true), a); return; }
    if (a.nodeType === 3 || a.nodeType === 8) { if (a.nodeValue !== b.nodeValue) a.nodeValue = b.nodeValue; return; }
    if (a.nodeType !== 1) return;
    var i, name, focused = a === document.activeElement && a !== forced;
    for (i = a.attributes.length - 1; i >= 0; i--) { name = a.attributes[i].name; if (!b.hasAttribute(name)) a.removeAttribute(name); }
    for (i = 0; i < b.attributes.length; i++) { name = b.attributes[i].name; if (a.getAttribute(name) !== b.attributes[i].value) a.setAttribute(name, b.attributes[i].value); }
    if (a.nodeName === 'INPUT') {
      if (!focused) {
        if (a.type === 'checkbox' || a.type === 'radio') a.checked = b.hasAttribute('checked');
        else a.value = b.getAttribute('value') || '';
      }
      return;
    }
    if (a.nodeName === 'TEXTAREA') { if (!focused) a.value = b.textContent; return; }
    patchChildren(a, b);
    if (a.nodeName === 'SELECT' && !focused) {
      for (i = 0; i < a.options.length; i++) a.options[i].selected = a.options[i].hasAttribute('selected');
    }
  }
  document.addEventListener('click', function (e) {
    var link = e.target.closest ? e.target.closest('a[q-link]') : null;
    if (link && e.button === 0 && !e.ctrlKey && !e.metaKey && !e.shiftKey && !e.altKey) {
      e.preventDefault();
      navigate(link.getAttribute('href'), true);
      return;
    }
    var el = e.target.closest ? e.target.closest('[q-click]') : null;
    if (el) { e.preventDefault(); flush(); send(el, el.getAttribute('q-click'), dataOf(el)); }
  });
  document.addEventListener('submit', function (e) {
    var f = e.target.closest ? e.target.closest('form[q-submit]') : null;
    if (!f) return;
    e.preventDefault();
    flush();
    var d = {};
    new FormData(f).forEach(function (v, k) { d[k] = String(v); });
    send(f, f.getAttribute('q-submit'), d, document.activeElement);
  });
  var timers = {};
  function flush() {
    var k, t;
    for (k in timers) { t = timers[k]; delete timers[k]; clearTimeout(t.id); t.run(); }
  }
  document.addEventListener('input', function (e) {
    var el = e.target.closest ? e.target.closest('[q-input]') : null;
    if (!el) return;
    var key = el.getAttribute('q-input');
    if (timers[key]) clearTimeout(timers[key].id);
    var run = function () { send(el, key, dataOf(el)); };
    timers[key] = { run: run, id: setTimeout(function () { delete timers[key]; run(); }, 150) };
  });
  document.addEventListener('change', function (e) {
    var el = e.target.closest ? e.target.closest('[q-change]') : null;
    if (el) { flush(); send(el, el.getAttribute('q-change'), dataOf(el)); }
  });
  document.addEventListener('keydown', function (e) {
    if (e.key !== 'Enter') return;
    var el = e.target.closest ? e.target.closest('[q-enter]') : null;
    if (el) { e.preventDefault(); flush(); send(el, el.getAttribute('q-enter'), dataOf(el), el); }
  });
  // @after timers, by key: started when an element with q-after first
  // appears, fired once with its current handler (if it's still there).
  // @after timers, by key: started when an element with q-after first
  // appears, fired once with its current handler (if it's still there).
  // q-pause-hover: the timer stops while the mouse is on the element.
  var afterTimers = {}, afterDone = {};
  function afterElement(key) {
    var all = document.querySelectorAll('[q-after-key]'), j, el = null;
    for (j = 0; j < all.length; j++) if (all[j].getAttribute('q-after-key') === key && !all[j].hasAttribute('q-leaving')) el = all[j];
    return el;
  }
  function runTimer(key, ms) {
    var t = afterTimers[key];
    t.end = Date.now() + ms;
    t.id = setTimeout(function () {
      delete afterTimers[key];
      afterDone[key] = true;
      var el = afterElement(key);
      if (el) { flush(); send(el, el.getAttribute('q-after'), {}); }
    }, ms);
  }
  function startTimers() {
    var els = document.querySelectorAll('[q-after][q-after-key]'), i;
    for (i = 0; i < els.length; i++) {
      (function (key, ms) {
        if (afterTimers[key] || afterDone[key] || !(ms > 0)) return;
        afterTimers[key] = { id: null, end: 0, left: 0, paused: false };
        runTimer(key, ms);
      })(els[i].getAttribute('q-after-key'), parseInt(els[i].getAttribute('delay') || '0', 10));
    }
  }
  function hoverKey(target) {
    var el = target && target.closest ? target.closest('[q-pause-hover][q-after-key]') : null;
    return el ? el.getAttribute('q-after-key') : null;
  }
  document.addEventListener('mouseover', function (e) {
    var key = hoverKey(e.target), t = key ? afterTimers[key] : null;
    if (!t || t.paused) return;
    clearTimeout(t.id);
    t.left = Math.max(0, t.end - Date.now());
    t.paused = true;
  });
  document.addEventListener('mouseout', function (e) {
    var key = hoverKey(e.target), t = key ? afterTimers[key] : null;
    if (!t || !t.paused || hoverKey(e.relatedTarget) === key) return;
    t.paused = false;
    runTimer(key, t.left);
  });
  function navigate(path, push) {
    fetch('/_live/nav?path=' + encodeURIComponent(path))
      .then(function (r) { return r.json(); })
      .then(function (res) {
        var root = document.querySelector('[q-root]');
        if (res.reload || !res.id || !root) { location.href = path; return; }
        root.setAttribute('q-root', res.id);
        var t;
        for (t in afterTimers) clearTimeout(afterTimers[t].id);
        afterTimers = {};
        afterDone = {};
        morph(root, res.html);
        startTimers();
        if (res.title) document.title = res.title;
        if (push) history.pushState({}, '', path);
        window.scrollTo(0, 0);
      })
      .catch(function () { location.href = path; });
  }
  window.addEventListener('popstate', function () { navigate(location.pathname + location.search, false); });
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', startTimers);
  else startTimers();
})();
"""

// ===== serving =====

// [pattern Route, factory] per live page, for navigation without a reload.
_pages := []
_installed := []
_settings := {"head": "", "layout": "", "layout_file": ""}
_layout_cache := {}

_default_layout := """<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
{{ head | raw }}
<script src="/_live/live.js" defer></script>
</head>
<body>
{{ body | raw }}
</body>
</html>"""

---
Page settings: `layout_file` — the base page every page is shown in (an
HTML file with `<slot />` where the page goes, and `{{ title }}`); by
default `index.html` in the app's folder when it has a `<slot />`.
`head` — HTML added to every page's <head>. `layout` — a page template
string (web's template syntax) with `{{ title }}`, `{{ head | raw }}` and
`{{ body | raw }}`.
---
define configure(head: String = "", layout: String = "", layout_file: String = "") -> void {
    _settings["head"] = head
    _settings["layout"] = layout
    _settings["layout_file"] = layout_file
}

---
Serve a live page at `path` (":params" allowed, as in web routes):
`factory(req)` makes the page's component — one per visitor, kept while
they use it. (A `live.Router` does this for you: `router.add(path, Page)`.)
---
define page(app: web.App, path: String, factory: Callable) -> void {
    _install(app)
    _pages.append([web.Route("GET", path, factory), factory])
    app.get(path, fn(req, res) {
        r: web.Request = req
        rs: web.Response = res
        comp := _make(factory, r)
        rs.html(_page_html(comp))
    })
}

define _make(factory: Callable, req: web.Request) -> Component {
    comp: Component = factory(req)
    if comp == null { throw web.HttpError(500, "live: the page factory returned null") }
    comp.request = req
    _store(comp)
    comp._start()
    return comp
}

define _page_html(comp: Component) -> String {
    t := comp.title()
    head: String = _settings["head"]
    body := comp._root_html()
    base := _layout_source()
    if base != "" {
        page := base.replace("{{ title }}", web.escape(t)).replace("{{title}}", web.escape(t))
        for tag in ["<slot />", "<slot/>", "<slot></slot>"] {
            slot_tag: String = tag
            page = page.replace(slot_tag, body)
        }
        script := "<script src=\"/_live/live.js\" defer></script>"
        extra := _notes_css + head + (page.contains("/_live/live.js") ? "" : script)
        if page.contains("</head>") {
            page = page.replace("</head>", extra + "</head>")
        } else {
            page = extra + page
        }
        return page
    }
    custom: String = _settings["layout"]
    layout := custom != "" ? custom : _default_layout
    return html(layout, {"title": t, "head": _notes_css + head, "body": body})
}

// The base page's text ("" for none), re-read when the file changes.
define _layout_source() -> String {
    path: String = _settings["layout_file"]
    explicit := path != ""
    if not explicit { path = "index.html" }
    if not fs.is_file(path) {
        if explicit { throw web.HttpError(500, "live: layout file not found: " + path) }
        return ""
    }
    stamp := String(fs.mtime(path)) + ":" + String(fs.size(path))
    if _layout_cache.has(path) {
        entry: List = _layout_cache[path]
        if String(entry[0]) == stamp {
            text: String = entry[1]
            return text
        }
    }
    text := fs.read_text(path)
    if not explicit and not text.contains("<slot") { text = "" }
    _layout_cache[path] = [stamp, text]
    return text
}

define _install(app: web.App) -> void {
    _install_on(app._router)
}

// "7.44.1" → [7, 44, 1] (missing parts: 0).
define _version_parts(v: String) -> List {
    out := []
    for p in v.split(".") {
        part: String = p
        digits := ""
        for c in part.split("") {
            ch: String = c
            if ch >= "0" and ch <= "9" { digits = digits + ch } else { break }
        }
        out.append(digits == "" ? 0 : Int(digits))
    }
    while out.length() < 3 { out.append(0) }
    return out
}

// `have` is at least `need` ("7.44.1").
define _version_at_least(have: String, need: String) -> Bool {
    a := _version_parts(have)
    b := _version_parts(need)
    i := 0
    while i < 3 {
        x: Int = a[i]
        y: Int = b[i]
        if x != y { return x > y }
        i = i + 1
    }
    return true
}

// Say so once when the compiler is older than this package needs.
define _check_quirk() -> void {
    if _installed.length() > 0 { return }
    v := sys.version()
    // (before 7.44.1, sys.version() always said "1.0.0")
    shown := v == "1.0.0" ? "older than 7.44.1" : v
    if not _version_at_least(v, "7.44.1") {
        print("live: this Quirk is " + shown + "; live 2 needs 7.44.1 or newer (enum fields show as numbers, props can't set them). Update Quirk.")
    }
}

// The /_live/ endpoints, once per router.
define _install_on(app: web.Router) -> void {
    _check_quirk()
    for a in _installed {
        known: web.Router = a
        if known == app { return }
    }
    _installed.append(app)
    app.get("/_live/live.js", fn(req, res) {
        rs: web.Response = res
        rs.set("Content-Type", "text/javascript; charset=utf-8")
        rs.set("Cache-Control", "public, max-age=3600")
        rs.send(_client_js)
    })
    app.post("/_live/event", fn(req, res) {
        r: web.Request = req
        rs: web.Response = res
        msg: Map = r.json()
        if msg == null { throw web.HttpError(400, "live: no event") }
        id := String(msg["id"])
        comp := _find(id)
        if comp == null {
            rs.json({"reload": true})              // expired / server restarted
            return
        }
        event := String(msg["event"])
        data: Map = {}
        if msg.has("data") and msg["data"] != null { data = msg["data"] }
        comp._go = ""
        if event.startswith("_note:") {
            _note_event(comp, event)
        } else {
            comp.handle(event, data)
        }
        if comp._go != "" {
            rs.json({"redirect": comp._go})
            return
        }
        rs.json({"html": _body(comp), "title": comp.title()})
    })
    app.get("/_live/nav", fn(req, res) {
        r: web.Request = req
        rs: web.Response = res
        target := r.query.has("path") ? String(r.query["path"]) : "/"
        nav := web.Request("GET", target, r.headers)
        for p in _pages {
            entry: List = p
            route: web.Route = entry[0]
            params := route.match_path(nav.path)
            if params != null {
                nav.params = params
                factory: Callable = entry[1]
                comp := _make(factory, nav)
                rs.json({"id": comp.id, "html": _body(comp), "title": comp.title()})
                return
            }
        }
        rs.json({"reload": true})                  // not a live page: load it normally
    })
}

---
The app's live pages, in one place (a `router.qk`, say):

    from live use { Router }
    from src.counter use { CounterPage }
    from src.todos use { TodoPage }

    router := Router()
    router.add("/", CounterPage)
    router.add("/todos", TodoPage)
    router.add("/users/:id", UserPage)       // self.param("id") in the page

and in the app, `app.mount("/", router)`. It's a `web.Router`, so it can
hold ordinary routes too (`router.get("/api/items", handler)`). Mount it
at "/" (the browser script talks to /_live/).
---
struct Router : web.Router {
    define __init(self) -> void {
        super().__init()
    }

    --- Serve the page struct `page` (its name: `router.add("/", HomePage)`) at `path`. ---
    define add(self, path: String, page: Callable) -> Router {
        _install_on(self)
        make := fn(req) { return page() }
        _pages.append([web.Route("GET", path, make), make])
        self.get(path, fn(req, res) {
            r: web.Request = req
            rs: web.Response = res
            comp := _make(make, r)
            rs.html(_page_html(comp))
        })
        return self
    }
}

// ===== testing =====

// A start tag (its text, without <) of an element that has no end tag.
define _void_tag(tag: String) -> Bool {
    name := tag.split(" ")[0]
    for v in ["input", "br", "img", "hr", "meta", "link", "source", "wbr", "area", "col", "embed", "track"] {
        vn: String = v
        if name == vn { return true }
    }
    return false
}

// The value of `attr` in a start tag's text (what TestSession sends).
define _attr_of(tag: String, attr: String, what: String) -> String {
    at := tag.find(attr + "=\"")
    if at < 0 { throw ValueError("live.TestSession: '" + what + "' has no " + attr.replace("q-", "@") + " handler") }
    rest := tag.substring(at + attr.length() + 2, tag.length())
    return rest.substring(0, rest.find("\""))
}

---
Drive live pages in tests, without a browser:

    s := live.TestSession(app)
    s.open("/")
    s.send("inc")
    test.assert_true(s.html.contains("<p>1</p>"))

`html` is the component's current HTML; `title` its title.
---
struct TestSession {
    client: web.TestClient
    id: String
    html: String
    title: String
    status: Int
    location: String

    define __init(self, app: web.App) -> void {
        self.client = web.TestClient(app)
        self.id = ""
        self.html = ""
        self.title = ""
        self.status = 0
        self.location = ""
    }

    --- Load the page at `path`. ---
    define open(self, path: String) -> TestSession {
        res := self.client.get(path)
        self.status = res.status_code
        self.html = res.body
        self.location = path
        at := res.body.find("q-root=\"")
        if at >= 0 {
            rest := res.body.substring(at + 8, res.body.length())
            self.id = rest.substring(0, rest.find("\""))
        }
        return self
    }

    --- Send `event` (with `data`) to the page's component, as the browser would. ---
    define send(self, event: String, data: Map = {}) -> TestSession {
        res := self.client.post_json("/_live/event", {"id": self.id, "event": event, "data": data})
        self.status = res.status_code
        if res.status_code != 200 { return self }
        m: Map = json.loads(res.body)
        if m.has("redirect") {
            self.navigate(String(m["redirect"]))
            return self
        }
        if m.has("html") { self.html = String(m["html"]) }
        if m.has("title") { self.title = String(m["title"]) }
        return self
    }

    --- Click the button (or other element) showing `text`. ---
    define click(self, text: String) -> TestSession {
        w := self._widget_for(text)
        if w != null { return self.send(w._on("click"), {"value": ""}) }
        return self.send(self._event_at(">" + text + "<", "q-click"), {})
    }

    --- Type `value` into the text field whose placeholder is `placeholder`. ---
    define type(self, placeholder: String, value: String) -> TestSession {
        w := self._widget_for(placeholder)
        if w != null { return self.send(w._on("change"), {"value": value}) }
        return self.send(self._event_at("placeholder=\"" + web.escape(placeholder) + "\"", "q-input"), {"value": value})
    }

    --- Type `value` into the text field with `placeholder` and press Enter. ---
    define submit(self, placeholder: String, value: String) -> TestSession {
        w := self._widget_for(placeholder)
        if w != null { return self.send(w._on("submit"), {"value": value}) }
        marker := "placeholder=\"" + web.escape(placeholder) + "\""
        if self._tag_at(marker).contains("q-input=") { self.send(self._event_at(marker, "q-input"), {"value": value}) }
        return self.send(self._event_at(marker, "q-enter"), {"value": value})
    }

    --- Tick (`on` true) or untick the checkbox labelled `text`. ---
    define check(self, text: String, on: Bool = true) -> TestSession {
        w := self._widget_for(text)
        value := on ? "true" : "false"
        if w != null { return self.send(w._on("change"), {"value": value}) }
        return self.send(self._event_at(text, "q-change"), {"value": value})
    }

    ---
    Pick an option: in a template's <select>, the option showing `option`
    (`index` unused); for a live.Dropdown, the one whose first option is
    `option`, at `index`.
    ---
    define choose(self, option: String, index: Int = 0) -> TestSession {
        w := self._widget_for(option)
        if w != null { return self.send(w._on("change"), {"value": String(index)}) }
        at := self.html.find(">" + web.escape(option) + "</option>")
        if at < 0 { throw ValueError("live.TestSession: no option '" + option + "' on the page") }
        before := self.html.substring(0, at)
        opt := before.split("<option")
        attrs: String = opt[opt.length() - 1]
        value := option
        v := attrs.find("value=\"")
        if v >= 0 {
            rest := attrs.substring(v + 7, attrs.length())
            value = rest.substring(0, rest.find("\""))
        }
        sel := before.split("<select")
        tag: String = sel[sel.length() - 1]
        return self.send(_attr_of(tag, "q-change", option), {"value": value})
    }

    --- Run every `@after` timer on the page now, once each (as if its delay had passed; `delay="0"`: never). ---
    define run_timers(self) -> TestSession {
        fired := {}
        while true {
            next_key := ""
            next_id := ""
            parts := self.html.split("q-after-key=\"")
            i := 1
            while i < parts.length() and next_key == "" {
                p: String = parts[i]
                key := p.substring(0, p.find("\""))
                at := p.find("q-after=\"")
                // the tag's start (before q-after-key): its delay= ("0": never)
                before: String = parts[i - 1]
                opens := before.split("<")
                tag_start: String = opens[opens.length() - 1]
                d := tag_start.find(" delay=\"")
                delay := 0
                if d >= 0 {
                    dv := tag_start.substring(d + 8, tag_start.length())
                    text := dv.substring(0, dv.find("\""))
                    if text != "" { delay = Int(text) }
                }
                if delay <= 0 { fired[key] = true }
                if not fired.has(key) and at >= 0 {
                    rest := p.substring(at + 9, p.length())
                    next_key = key
                    next_id = rest.substring(0, rest.find("\""))
                }
                i = i + 1
            }
            if next_key == "" { return self }
            fired[next_key] = true
            self.send(next_id, {})
        }
        return self
    }

    --- Submit the form holding the field with `placeholder` (or name), with `fields`. ---
    define submit_form(self, field: String, fields: Map) -> TestSession {
        at := self.html.find("placeholder=\"" + web.escape(field) + "\"")
        if at < 0 { at = self.html.find("name=\"" + web.escape(field) + "\"") }
        if at < 0 { throw ValueError("live.TestSession: no field '" + field + "' on the page") }
        forms := self.html.substring(0, at).split("<form")
        tag: String = forms[forms.length() - 1]
        return self.send(_attr_of(tag, "q-submit", field), fields)
    }

    define _widget_for(self, label: String) -> Widget {
        comp := _find(self.id)
        if comp == null { throw ValueError("live.TestSession: no page open") }
        return comp._widget(label)
    }

    // The start tag holding the first `marker` in the page.
    define _tag_at(self, marker: String) -> String {
        at := self.html.find(marker)
        if at < 0 { throw ValueError("live.TestSession: nothing showing '" + marker + "' on the page") }
        pieces := self.html.substring(0, at).split("<")
        last: String = pieces[pieces.length() - 1]
        rest := self.html.substring(at - last.length(), self.html.length())
        close := rest.find(">")
        return close < 0 ? rest : rest.substring(0, close)
    }

    // `attr` of the element around the first `marker` — that element's, or
    // the nearest enclosing one's that has it (a click on a notification's
    // text reaches the notification, as in a browser).
    define _event_at(self, marker: String, attr: String) -> String {
        tag := self._tag_at(marker)
        if tag.contains(attr + "=\"") { return _attr_of(tag, attr, marker) }
        at := self.html.find(marker)
        if at < 0 { return _attr_of(tag, attr, marker) }
        // Walk the tags before the marker backwards; an opening tag while no
        // closing one is pending is an ancestor.
        tags := self.html.substring(0, at).split("<")
        pending := 0
        i := tags.length() - 1
        while i >= 1 {
            t: String = tags[i]
            close := t.find(">")
            inner := close >= 0 ? t.substring(0, close) : t
            if inner.startswith("/") {
                pending = pending + 1
            } elif not inner.startswith("!") and not inner.endswith("/") and not _void_tag(inner) {
                if pending == 0 {
                    if inner.contains(attr + "=\"") { return _attr_of(inner, attr, marker) }
                } else {
                    pending = pending - 1
                }
            }
            i = i - 1
        }
        return _attr_of(tag, attr, marker)
    }

    --- Follow a `q-link` to `path`. ---
    define navigate(self, path: String) -> TestSession {
        res := self.client.get("/_live/nav?path=" + path)
        self.status = res.status_code
        m: Map = json.loads(res.body)
        self.location = path
        if m.has("reload") { return self.open(path) }
        self.id = String(m["id"])
        self.html = String(m["html"])
        self.title = String(m["title"])
        return self
    }
}
