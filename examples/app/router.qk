// Every page of the app, in one place.
from live use { Router }
from src.pages.counter use { CounterPage }
from src.pages.todos use { TodoPage }
from src.pages.hello use { HelloPage }
from src.pages.login use { LoginPage }
from src.pages.signup use { SignupPage }
from src.pages.account use { AccountPage }
from src.pages.live use { LivePage }
from src.pages.settings use { SettingsPage }
from src.layouts.main use { MainLayout }
from src.layouts.account use { AccountLayout }
use live

router = Router()

// These pages are shown in MainLayout: it stays while you go from one to
// another, only its <slot /> (the page) changes.
main := router.group(layout=MainLayout)
main.add("/", CounterPage)
main.add("/todos", TodoPage)
main.add("/hello/:name", HelloPage)
main.add("/live", LivePage)
main.add("/login", LoginPage)
main.add("/signup", SignupPage)

// A group inside `main`: these pages are in AccountLayout, itself in
// MainLayout's slot — and for logged-in visitors only (others go to /login,
// and come back after).
account := main.group(layout=AccountLayout, guard=live.require_login())
account.add("/account", AccountPage)
account.add("/account/settings", SettingsPage)
