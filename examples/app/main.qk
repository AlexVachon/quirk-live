// The live demo app: quirk run --watch main.qk, then open http://localhost:3000
// (--watch: restarted on every save; the open tabs reload)
// index.html is the base page; src/pages/ has the pages, src/components/ the components.
use web
use sys

from router use { router }
from src.store use { db }

const PORT: Int = 3000

define main() -> void {
    app := web.App()
    app.use(web.static("public"))
    // The visitor's session (login: src/pages/login.qk), kept in the app's
    // database — it lasts across restarts (and every save under --watch).
    app.use(web.sessions(store=web.sqlite_store(db=db())))
    app.mount("/", router)
    
    app.listen(PORT)
}
