// The live demo app: quirk run main.qk, then open http://localhost:3000
// index.html is the base page; src/pages/ has the pages, src/components/ the components.
use web
use sys

from router use { router }

const PORT: Int = 3000

define main() -> void {
    app := web.App()
    app.use(web.static("public"))
    app.mount("/", router)
    
    app.listen(PORT)
}
