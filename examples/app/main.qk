// The live demo app: quirk run --watch main.qk, then open http://localhost:3000
// (--watch: restarted on every save; the open tabs reload)
// index.html is the base page; src/pages/ has the pages, src/components/ the components.
use web
use sys

from router use { router }

const PORT: Int = 3000

define main() -> void {
    app := web.App()
    app.use(web.static("public"))
    app.use(web.sessions())          // the visitor's session: login (src/pages/login.qk)
    app.mount("/", router)
    
    app.listen(PORT)
}
