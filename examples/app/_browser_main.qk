// (test entry for tests/browser: the demo on $PORT; not part of the app)
use web
use sys
from router use { router }
from src.store use { use_database, db }

define main() -> void {
    use_database(":memory:")          // each run starts from the same two todos
    app := web.App()
    app.use(web.static("public"))
    app.use(web.sessions(store=web.sqlite_store(db=db())))
    app.mount("/", router)
    app.listen(Int(sys.getenv("PORT")))
}
