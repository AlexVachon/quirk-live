use live

struct CounterPage : live.Page {
    count: Int

    define on_load(self) -> void {
        self.count = 0
    }

    define add(self, n: Int) -> void {
        self.count = self.count + n
    }

    define reset(self) -> void {
        self.count = 0
    }

    define title(self) -> String {
        return "Counter (" + String(self.count) + ")"
    }
}

// A component of your own, used in the page's template as <PlusButton />.
struct PlusButton : live.Component {
    page: CounterPage
    step: Int

    define press(self) -> void {
        self.page.add(self.step)
    }
}
