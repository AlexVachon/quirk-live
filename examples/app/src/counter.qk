use live
from src.nav use { nav }

struct CounterPage : live.Page {
    count: Int

    define on_load(self) -> void {
        self.count = 0
    }

    define build(self) -> live.Widget {
        widgets := [
            nav(),
            live.Heading("Counter"),
            live.Label(String(self.count)).with_class("count"),
            live.Row([
                live.Button("−1", on_click=fn() { self.count = self.count - 1 }),
                PlusButton(self),
                live.Button("reset", on_click=fn() { self.count = 0 }),
            ]),
        ]
        if self.count >= 10 { widgets.append(live.Label("That's a lot!")) }
        return live.Column(widgets)
    }

    define title(self) -> String {
        return "Counter (" + String(self.count) + ")"
    }
}

// A component of your own: a Button with its own on_click.
struct PlusButton : live.Button {
    page: CounterPage

    define __init(self, page: CounterPage) -> void {
        super().__init("+1")
        self.page = page
    }

    define on_click(self) -> void {
        self.page.count = self.page.count + 1
    }
}
