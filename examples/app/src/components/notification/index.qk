use live

enum NotificationStatus {
    Info
    Success
    Warning
    Error
}

---
A message that closes itself after `timeout` milliseconds (0: it stays
until closed). Tells its parent with `emit("dismiss")`.

    <Notification message="Saved" status="Success" :timeout="3000" @dismiss="remove(id)" />
---
struct Notification : live.Component {
    message: String
    title: String
    status: NotificationStatus
    timeout: Int

    define icon(self) -> String {
        if self.status == NotificationStatus.Success { return "✓" }
        if self.status == NotificationStatus.Warning { return "!" }
        if self.status == NotificationStatus.Error { return "✕" }
        return "i"
    }

    // Errors and warnings interrupt a screen reader; the others wait.
    define role(self) -> String {
        if self.status == NotificationStatus.Error or self.status == NotificationStatus.Warning { return "alert" }
        return "status"
    }

    define dismiss(self) -> void {
        self.emit("dismiss")
    }

    define template(self) -> String {
        return r"""
            <div class="notification {{ status.lower }}" role="{{ role }}" @after="dismiss" delay="{{ timeout }}">
              <span class="icon" aria-hidden="true">{{ icon }}</span>
              <div class="body">
                {% if title %}<strong>{{ title }}</strong>{% end %}
                <p>{{ message }}</p>
              </div>
              <button class="close" @click="dismiss" aria-label="Close">×</button>
              {% if timeout > 0 %}<div class="time-left" style="animation-duration: {{ timeout }}ms"></div>{% end %}
            </div>
        """
    }
}
