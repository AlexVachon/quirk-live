use live

struct CounterPage : live.Page {
    count: Int
    before_reset: Int
    undo_note: Int
    closed: Int          // notifications closed so far (on_close)

    define on_load(self) -> void {
        self.count = 0
        self.before_reset = 0
        self.undo_note = 0
        self.closed = 0
    }

    define add(self, n: Int) -> void {
        before := self.count
        self.count = self.count + n
        if before < 10 and self.count >= 10 {
            self.notify("You reached 10!", title="Well done", type="success", on_close=fn() { self.closed = self.closed + 1 })
        }
        if before >= 0 and self.count < 0 {
            self.notify("The count is below zero.", title="Careful", type="warning", position="bottom-right", duration=0,
                        on_close=fn() { self.closed = self.closed + 1 })
        }
    }

    define reset(self) -> void {
        self.before_reset = self.count
        self.count = 0
        self.undo_note = self.notify("Counter reset — click here to undo.", type="info", position="top-left", duration=5000,
                                     on_click=fn() { self.undo() }, on_close=fn() { self.closed = self.closed + 1 })
    }

    define undo(self) -> void {
        self.count = self.before_reset
        self.close_notification(self.undo_note)
    }

    define title(self) -> String {
        return "Counter (" + String(self.count) + ")"
    }

    define template(self) -> String {
        return r"""
            <section class="counter">
              <h1>Counter</h1>
              <p class="count">{{ count }}</p>
              <div class="buttons">
                <button @click="add(-1)">−1</button>
                <PlusButton :page="self" :step="1" />
                <PlusButton :page="self" :step="10" />
                <button @click="reset">reset</button>
              </div>
              {% if count >= 10 %}<p class="note">That's a lot!</p>{% end %}
              <p class="closed">notifications closed: {{ closed }}</p>
            </section>
        """
    }
}

// A component of your own, used in the page's template as <PlusButton />.
// Components can notify too.
struct PlusButton : live.Component {
    page: CounterPage
    step: Int

    define press(self) -> void {
        self.page.add(self.step)
        if self.step >= 10 { self.notify("+" + String(self.step) + " in one go.", position="bottom-left", duration=2500) }
    }

    define template(self) -> String {
        return r"""<button class="plus" @click="press">+{{ step }}</button>"""
    }
}
