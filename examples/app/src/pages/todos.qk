use live

struct TodoPage : live.Page {
    items: List
    draft: String
    filter: String

    define on_load(self) -> void {
        // Load from a database or an API here.
        self.items = ["buy milk", "write docs"]
        self.draft = ""
        self.filter = ""
    }

    define add(self) -> void {
        t := self.draft.trim()
        if t != "" { self.items.append(t) }
        self.draft = ""
    }

    define remove(self, index: Int) -> void {
        kept := []
        j := 0
        for it in self.items {
            if j != index { kept.append(it) }
            j = j + 1
        }
        self.items = kept
    }

    // The items matching the search, with their index in `items`.
    define shown(self) -> List {
        out := []
        i := 0
        for it in self.items {
            text: String = it
            if self.filter == "" or text.contains(self.filter) { out.append({"text": text, "index": i}) }
            i = i + 1
        }
        return out
    }

    define title(self) -> String {
        return "Todos (" + String(self.items.length()) + ")"
    }

    define template(self) -> String {
        return r"""
            <h1>Todos</h1>
            <div class="add">
              <input model="draft" placeholder="Something to do" @enter="add()">
              <button @click="add">Add</button>
            </div>
            <input model="filter" placeholder="Search">
            <ul>
              {% for item in shown %}
                <TodoRow :text="item.text" :index="item.index" :key="item.index" @remove="remove" />
              {% else %}
                <li class="empty">Nothing here</li>
              {% end %}
            </ul>
        """
    }
}

// One line of the list; tells the page when its × is clicked.
struct TodoRow : live.Component {
    text: String
    index: Int

    define remove(self) -> void {
        self.emit("remove", self.index)
    }

    define template(self) -> String {
        return r"""
            <style scoped>
              li { display: flex; gap: .5rem; align-items: center; }
              .remove { border: none; background: none; color: #dc2626; font-size: 1.1rem; cursor: pointer; }
              .remove:hover { color: #991b1b; }
            </style>
            <li>{{ text }} <button class="remove" @click="remove" aria-label="Remove {{ text }}">×</button></li>
        """
    }
}
