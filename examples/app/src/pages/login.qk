use live

// A demo login: any name, password "quirk". A real app checks a database.
// Validation: rules() is checked as you leave each field and on submit;
// set_error() shows what only the server knows (a wrong password).
struct LoginPage : live.Page {
    name: String
    password: String

    define on_load(self) -> void {
        self.name = ""
        self.password = ""
    }

    define rules(self) -> Map {
        return {
            "name":     [live.required("Your name, please"), live.max_length(30)],
            "password": [live.required("The password, please (it's quirk)")],
        }
    }

    define submit(self) -> void {
        if not self.valid() { return }
        if self.password != "quirk" {
            self.set_error("password", "Wrong password — try quirk")
            return
        }
        self.login(self.name.trim())
        self.notify("Welcome, " + self.name.trim() + "!", type="success", duration=3000)
        next := self.query("next")
        self.go(next != "" ? next : "/account")
    }

    define title(self) -> String {
        return "Log in"
    }

    define template(self) -> String {
        return r"""
            <h1>Log in</h1>
            <form class="login" @submit="submit">
              <input model="name" placeholder="Name" autocomplete="username">
              <FieldError field="name" />
              <input type="password" model="password" placeholder="Password" autocomplete="current-password">
              <FieldError field="password" />
              <button>Log in</button>
            </form>
        """
    }
}
