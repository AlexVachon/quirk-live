use live
from src.store use { check_login, User }

// Log in with an account made on /signup. The password is checked against
// its stored scrypt hash; a wrong email and a wrong password get the same
// answer (which emails have an account isn't given away).
struct LoginPage : live.Page {
    email: String
    password: String

    define on_load(self) -> void {
        self.email = ""
        self.password = ""
    }

    define rules(self) -> Map {
        return {
            "email":    [live.required("Your email, please"), live.email()],
            "password": [live.required("Your password, please")],
        }
    }

    define submit(self) -> void {
        if not self.valid() { return }
        found := check_login(self.email, self.password)
        if found == null {
            self.set_error("password", "Wrong email or password")
            return
        }
        u: User = found
        self.login(u.name)
        self.notify("Welcome back, " + u.name + "!", type="success", duration=3000)
        next := self.query("next")
        self.go(next != "" ? next : "/account")
    }

    define title(self) -> String {
        return "Log in"
    }

    define template(self) -> String {
        return r"""
            <h1>Log in</h1>
            <form class="login" @submit="submit">
              <input type="email" model="email" placeholder="Email" autocomplete="username">
              <FieldError field="email" />
              <input type="password" model="password" placeholder="Password" autocomplete="current-password">
              <FieldError field="password" />
              <button>Log in</button>
            </form>
            <p>No account yet? <a href="/signup" q-link>Sign up</a></p>
        """
    }
}
